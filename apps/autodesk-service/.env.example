# Copy to .env.local; keep real secrets out of tracked files and VITE_* variables.
AUTODESK_VIEWER_ORIGIN=http://localhost:3000
AUTODESK_CLIENT_ID=replace-with-registered-application-id
AUTODESK_CLIENT_SECRET=replace-locally-with-server-secret
AUTODESK_INSECURE_LOCALHOST=true
AUTODESK_SERVICE_PORT=3002
# Register http://localhost:3000/api/autodesk/callback in the APS application.
# Build/start the viewer with VITE_AUTODESK_HOSTED=true.
# Optional native imports: absolute executable paths on the service host.
AUTODESK_FORMA_CONVERTER=/absolute/path/to/ifc-lite-cloud-import
# Windows service host only; leave unset on Linux.
# AUTODESK_EXCHANGE_WORKER=C:\IFClite\worker\AutodeskExchangeWorker.exe
