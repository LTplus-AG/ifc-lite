{
  "name": "@ifc-lite/autodesk-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Session-owned Autodesk cloud API gateway for the IFClite viewer",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
