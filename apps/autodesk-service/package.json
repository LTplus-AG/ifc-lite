    "@ifc-lite/source-autodesk": "workspace:^",
    "@mergifyio/vitest": "^2026.11.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
