# Copy to an ACL-protected, untracked .env.local outside the release directory.
# Example paths; replace the hostname and both APS placeholders before startup.
AUTODESK_VIEWER_ORIGIN=https://cloud.example.com
AUTODESK_CLIENT_ID=replace-with-registered-application-id
AUTODESK_CLIENT_SECRET=replace-with-server-only-secret
AUTODESK_INSECURE_LOCALHOST=false
AUTODESK_SERVICE_HOST=127.0.0.1
AUTODESK_SERVICE_PORT=3002
AUTODESK_FORMA_CONVERTER=C:\IFClite\current\native\ifc-lite-cloud-import.exe
AUTODESK_EXCHANGE_WORKER=C:\IFClite\current\exchange\AutodeskExchangeWorker.exe
