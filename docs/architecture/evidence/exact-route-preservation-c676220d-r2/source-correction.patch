index 0000000000..e07c37f155
--- /dev/null
+++ b/scripts/exact-route-compiler.mjs
@@ -0,0 +1,48 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+export function compilerEnvironment(env) {
+  if (!env || typeof env !== 'object' || Array.isArray(env) || Object.values(env).some(v => typeof v !== 'string')) throw Error('invalid compiler environment evidence');
+  for (const key of Object.keys(env)) {
+    if (key.startsWith('CARGO_PROFILE_')) throw Error(`profile override refused: ${key}`);
+    if (key.startsWith('IFC_LITE_')) throw Error(`geometry override refused: ${key}`);
+  }
+  for (const key of ['RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER']) {
+    if (env[key]) throw Error(`unverifiable additional compiler wrapper refused: ${key}`);
+  }
+  const names = ['RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS', 'RUSTUP_TOOLCHAIN', 'CARGO_BUILD_TARGET',
+    'CARGO_TARGET_DIR', 'RAYON_NUM_THREADS', 'RUSTC', 'RUSTDOCFLAGS', 'CARGO_BUILD_RUSTFLAGS'];
+  return Object.fromEntries(Object.entries(env).filter(([k]) => names.includes(k) ||
+    /^CARGO_TARGET_.*_(RUSTFLAGS|LINKER|RUNNER)$/.test(k)));
+}
+export function compilerEvidence(events, artifacts) {
+  if (!Array.isArray(events) || !events.length || events.some(e => typeof e.compiler !== 'string' || typeof e.version !== 'string' || !e.version ||
+      !Array.isArray(e.args) || e.args.some(a => typeof a !== 'string'))) throw Error('missing/malformed compiler arguments');
+  const example = events.filter(e => e.args.some((a, i) => a === '--crate-name' && e.args[i + 1] === 'exact_route_capture'));
+  const artifact = artifacts.findLast(a => a.reason === 'compiler-artifact' && a.target?.name === 'exact_route_capture' && a.executable);
+  if (!example.length || !artifact || artifact.fresh !== false || !artifact.profile ||
+      artifact.profile.debug_assertions !== false || artifact.profile.test !== false) throw Error('no freshly compiled ordinary-profile capture example');
+  const profile = artifact.profile;
+  if (typeof profile.opt_level !== 'string' || !/^[0123sz]$/.test(profile.opt_level) ||
+      !Object.hasOwn(profile, 'debuginfo') || !(profile.debuginfo === null ||
+        [0, 1, 2, 'none', 'limited', 'full', 'line-tables-only', 'line-directives-only'].includes(profile.debuginfo)) ||
+      typeof profile.overflow_checks !== 'boolean' || !Array.isArray(artifact.features) ||
+      artifact.features.some(v => typeof v !== 'string')) throw Error('incomplete effective compiler profile/features');
+  for (const event of example) {
+    if (!event.args.some(a => a.includes('opt-level=')) ||
+        event.args.some(a => /panic=(abort|immediate-abort)/.test(a))) throw Error('unexpected effective capture compiler policy');
+  }
+  const policies = example.map(e => {
+    const result = [];
+    for (let i = 0; i < e.args.length; i++) {
+      const arg = e.args[i];
+      if (['-C', '-Z', '--target', '--cfg'].includes(arg)) {
+        const value = e.args[++i];
+        if (typeof value !== 'string') throw Error('incomplete compiler option');
+        if (!/^(metadata|extra-filename|incremental)=/.test(value)) result.push(arg, value);
+      } else if (/^(-C|-Z|--target=|--cfg=)/.test(arg) && !/^-C(metadata|extra-filename|incremental)=/.test(arg)) result.push(arg);
+    }
+    return { version: e.version, optionsInOrder: result };
+  });
+  return { events, exampleProfile: artifact.profile, exampleFeatures: artifact.features, policies };
+}
