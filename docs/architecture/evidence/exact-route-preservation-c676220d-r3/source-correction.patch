+  if (!crate || !out) return {};
+  let suffix = '';
+  for (let i = 0; i < args.length; i++) {
+    const value = args[i] === '-C' ? args[i + 1] : args[i].startsWith('-C') ? args[i].slice(2) : '';
+    if (value?.startsWith('extra-filename=')) suffix = value.slice('extra-filename='.length);
+  }
