+++ b/scripts/exact-route-externs.test.mjs
@@ -0,0 +1,60 @@
+/* This Source Code Form is subject to the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { writeFileSync } from 'node:fs';
+import { join, dirname } from 'node:path';
+import { compilerFixture, profile } from './lib/exact-route-unit-fixture.mjs';
+import { compilerEvidence } from './exact-route-compiler.mjs';
+import { compareUnitPolicies } from './exact-route-units.mjs';
+import { sysrootInputs } from './exact-route-externs.mjs';
+import { sha256 } from './exact-route-source.mjs';
+const evidence = f => compilerEvidence(f.events, f.artifacts, f.context, f.files);
+function hostArtifacts(f) {
+  const unit = structuredClone(f.artifacts[0]), event = structuredClone(f.events[0]);
+  const source = join(event.package.root, 'build.rs'), terminal = join(dirname(unit.filenames[0]), 'build_script_build-fixture');
+  const copied = join(dirname(unit.filenames[0]), 'build-script-build');
+  event.inputsBefore['build.rs'] = event.inputsAfter['build.rs'] = sha256('// source-evident build script');
+  event.args = ['--crate-name', 'build_script_build', source, '--out-dir', dirname(terminal), '--crate-type', 'bin', '-C', 'opt-level=3'];
+  event.outputs = { [terminal]: sha256('compiled host executable') };
+  f.files[copied] = sha256('compiled host executable');
+  unit.target = { name: 'build-script-build', kind: ['custom-build'], src_path: source };
+  unit.filenames = [copied]; unit.executable = copied; unit.profile = profile();
+  f.events.push(event); f.artifacts.push(unit);
+  // Cargo reports a proc-macro shared library and --extern passes that .so
+  // to the downstream target compiler, not an rlib guessed from its name.
+  const macro = structuredClone(f.artifacts[0]), compile = structuredClone(f.events[0]);
+  const macroSource = join(compile.package.root, 'macro.rs'), library = join(dirname(terminal), 'libfixture_macro-fixture.so');
+  compile.inputsBefore['macro.rs'] = compile.inputsAfter['macro.rs'] = sha256('// proc macro source');
+  compile.args = ['--crate-name', 'fixture_macro', macroSource, '--out-dir', dirname(library), '--crate-type', 'proc-macro', '--extern', 'proc_macro', '-C', 'opt-level=3'];
+  const sysroot = dirname(library), procMacro = join(sysroot, 'libproc_macro-0123abcd.rlib');
+  writeFileSync(procMacro, 'toolchain proc macro bytes');
+  compile.sysrootExternsBefore = sysrootInputs('fixture-rustc', compile.args, () => ({ status: 0, stdout: sysroot }));
+  compile.sysrootExternsAfter = structuredClone(compile.sysrootExternsBefore);
+  compile.outputs = { [library]: sha256('proc macro shared object') }; f.files[library] = compile.outputs[library];
+  macro.target = { name: 'fixture_macro', kind: ['proc-macro'], src_path: macroSource }; macro.filenames = [library];
+  f.events.push(compile); f.artifacts.push(macro);
+  f.events.at(-3).args.push('--extern', `fixture_macro=${library}`);
+  f.events.at(-3).externInputs[library] = f.events.at(-3).externAfter[library] = f.files[library];
+  return { compile, copied };
+}
+test('Cargo host build-script copy, proc-macro shared object, and bare sysroot proc_macro are explicitly bound', t => {
+  const a = compilerFixture(t), b = compilerFixture(t); hostArtifacts(a); hostArtifacts(b);
+  assert.doesNotThrow(() => compareUnitPolicies(evidence(a).units, evidence(b).units));
+  assert.equal(evidence(a).units.length, 7);
+});
+for (const change of ['bytes', 'query', 'missing', 'unknown', 'build-copy']) test(`Cargo host artifact shape refuses ${change}`, t => {
+  const f = compilerFixture(t), { compile, copied } = hostArtifacts(f);
+  if (change === 'bytes') compile.sysrootExternsAfter[0].sha256 = 'a'.repeat(64);
+  if (change === 'query') compile.sysrootExternsBefore[0].query.push('--target', 'foreign');
+  if (change === 'missing') delete compile.sysrootExternsBefore;
+  if (change === 'unknown') compile.args[compile.args.indexOf('proc_macro')] = 'unqualified_crate';
+  if (change === 'build-copy') f.files[copied] = 'a'.repeat(64);
+  assert.throws(() => evidence(f));
+});
+test('different toolchain sysroot bytes cannot hide behind same rustc version', t => {
+  const a = compilerFixture(t), b = compilerFixture(t); hostArtifacts(a); const { compile } = hostArtifacts(b);
+  compile.sysrootExternsBefore[0].sha256 = compile.sysrootExternsAfter[0].sha256 = 'a'.repeat(64);
+  assert.throws(() => compareUnitPolicies(evidence(a).units, evidence(b).units));
+});
diff --git a/scripts/exact-route-graph.mjs b/scripts/exact-route-graph.mjs
new file mode 100644
index 0000000000..6f51f789f7
--- /dev/null
+++ b/scripts/exact-route-graph.mjs
@@ -0,0 +1,110 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+// @unwired-by-design Offline draft/review utility; never qualifies a draft itself.
+import { readFileSync, writeFileSync } from 'node:fs';
+import { pathToFileURL } from 'node:url';
+import { isDeepStrictEqual } from 'node:util';
+import { digest } from './exact-route-inputs.mjs';
+import { sha256 } from './exact-route-source.mjs';
+const equal = (a, b, why) => { if (!isDeepStrictEqual(a, b)) throw Error(why); };
+const sourcePin = r => ({ compileContextSha256: r.compilerContextSha256, commit: r.source, tree: r.sourceTree,
+  inputsSha256: digest(r.trackedSourceHashes), cargoLock: r.trackedSourceHashes['Cargo.lock'],
+  manifests: Object.fromEntries(Object.entries(r.trackedSourceHashes).filter(([p]) => p === 'Cargo.toml' || p.endsWith('/Cargo.toml'))) });
+export function graphUnits(rows) {
+  return rows.map(row => {
+    const links = row.linked.map(link => {
+      if (link.kind === 'sysroot') return link;
+      const owners = rows.filter(u => u.artifacts[link.path] === link.sha256);
+      if (owners.length !== 1) throw Error('ambiguous graph linked artifact owner');
+      return { name: link.name, unit: owners[0].key };
+    });
+    const { key, package: name, workspace, sourceDigest, manifestPath, manifestSha256, profile, features, policy } = row;
+    return { key, package: name, workspace, sourceDigest, manifestPath, manifestSha256, profile, features, policy, links };
+  });
+}
+export function draftGraph(a, b) {
+  // A draft is a literal record, NOT authorization. The parent must review all
+  // policies/edges and supply the independent digest of the reviewed file.
+  const sides = [a, b].map(r => ({ source: sourcePin(r), units: graphUnits(r.compiler.units) }));
+  const keys = sides.map(s => new Set(s.units.map(u => u.key)));
+  return { format: 'exact-route-reviewed-graph-v1', sides,
+    added: [...keys[1]].filter(k => !keys[0].has(k)), removed: [...keys[0]].filter(k => !keys[1].has(k)),
+    workspacePackages: ['ifc-lite-imported-geometry', 'ifc-lite-geometry-runtime'],
+    externalTransitions: [], featureDeclarations: [] };
+}
+function stripped(policy, links, common, declaration) {
+  const args = policy.optionsInOrder, out = [];
+  const extras = new Set(links.filter(l => !common.some(c => isDeepStrictEqual(l, c))).map(l => l.name));
+  let declarations = 0;
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === '--extern' && extras.has(args[i + 1]?.split('=')[0])) { i++; continue; }
+    if (declaration && args[i] === '--check-cfg' && args[i + 1] === declaration) {
+      declarations++; i++; continue;
+    }
+    out.push(args[i]);
+  }
+  if (declaration && declarations !== 1) throw Error('feature declaration argument missing/repeated');
+  return { version: policy.version, optionsInOrder: out };
+}
+export function compareReviewedGraph(a, b, expected, expectedHash) {
+  if (!/^[a-f0-9]{64}$/.test(expectedHash ?? '') || sha256(expected.bytes) !== expectedHash) throw Error('independent reviewed graph digest required');
+  const witness = JSON.parse(expected.bytes);
+  if (witness.format !== 'exact-route-reviewed-graph-v1' || !Array.isArray(witness.sides) || witness.sides.length !== 2 ||
+      !Array.isArray(witness.workspacePackages) || !Array.isArray(witness.externalTransitions) || !Array.isArray(witness.featureDeclarations)) throw Error('invalid reviewed graph witness');
+  const observed = draftGraph(a, b);
+  equal(witness.sides, observed.sides, 'reviewed source/unit/policy/edge witness mismatch');
+  for (const k of ['added', 'removed']) equal(witness[k], observed[k], `reviewed graph ${k} differs`);
+  const [left, right] = witness.sides.map(s => new Map(s.units.map(u => [u.key, u])));
+  for (const [i, map] of [left, right].entries()) {
+    if (map.size !== witness.sides[i].units.length) throw Error('duplicate graph unit');
+    const pins = witness.sides[i].source;
+    if (!pins.cargoLock || !pins.manifests['Cargo.toml']) throw Error('graph source lacks Cargo manifest/lock pins');
+    for (const row of map.values()) if (row.workspace && pins.manifests[row.manifestPath] !== row.manifestSha256) throw Error('workspace unit ownership not manifest-bound');
+  }
+  const sysroots = witness.sides.map(s => {
+    const result = new Map();
+    for (const u of s.units) for (const link of u.links.filter(l => l.kind === 'sysroot')) {
+      if (result.has(link.name)) equal(result.get(link.name), link.sha256, 'inconsistent toolchain sysroot bytes');
+      result.set(link.name, link.sha256);
+    }
+    return result;
+  });
+  for (const [name, sha] of sysroots[0]) if (sysroots[1].has(name)) equal(sha, sysroots[1].get(name), 'toolchain sysroot bytes differ');
+  const externalUsed = new Set(), declarationsUsed = new Set();
+  for (const key of new Set([...left.keys(), ...right.keys()])) {
+    const x = left.get(key), y = right.get(key), row = x ?? y;
+    const external = witness.externalTransitions.includes(key);
+    if (!row.workspace && external) externalUsed.add(key);
+    if (!x || !y) {
+      if (row.workspace ? !witness.workspacePackages.includes(row.package) : !external) throw Error(`unknown graph addition/removal: ${key}`);
+      // Full source, manifest hash, features, compiler arguments and edges of
+      // every one-sided unit remain literal in the independently pinned sides.
+      continue;
+    }
+    if (x.workspace !== y.workspace || x.manifestPath !== y.manifestPath) throw Error('unit changed source ownership');
+    if (!row.workspace && !external) equal(x, y, `external source/policy/edges changed: ${key}`);
+    if (!row.workspace && external) continue; // Exact before/after expectation, never a package-wide exemption.
+    for (const field of ['profile', 'features']) equal(x[field], y[field], `common workspace ${field} changed: ${key}`);
+    if (!isDeepStrictEqual(x.links, y.links) && x.manifestSha256 === y.manifestSha256) throw Error('common workspace edge transition lacks changed owning Cargo manifest');
+    const common = x.links.filter(l => y.links.some(r => isDeepStrictEqual(l, r)));
+    equal(common, y.links.filter(l => x.links.some(r => isDeepStrictEqual(l, r))), 'common dependency order changed');
+    const declaration = witness.featureDeclarations.find(d => d.unit === key);
+    if (declaration) {
+      if (witness.featureDeclarations.filter(d => d.unit === key).length !== 1 || x.manifestSha256 === y.manifestSha256 ||
+          declaration.manifest !== x.manifestPath || ![declaration.before, declaration.after].every(v =>
+            typeof v === 'string' && /^cfg\(feature, values\((?:"[A-Za-z0-9_+.-]+"(?:, )?)*\)\)$/.test(v))) throw Error('invalid source-pinned feature declaration transition');
+      declarationsUsed.add(key);
+    }
+    equal(stripped(x.policy, x.links, common, declaration?.before), stripped(y.policy, y.links, common, declaration?.after), `common workspace compiler policy changed: ${key}`);
+  }
+  if (externalUsed.size !== witness.externalTransitions.length || declarationsUsed.size !== witness.featureDeclarations.length) throw Error('unused/repeated transition authorization');
+  return { sha256: expectedHash, added: witness.added, removed: witness.removed,
+    sides: witness.sides.map(s => ({ source: s.source, units: s.units.length })) };
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const [a, b, out] = process.argv.slice(2);
+  if (!a || !b || !out) throw Error('usage: exact-route-graph.mjs BASE_RECEIPT BRANCH_RECEIPT NEW_DRAFT_FILE');
+  writeFileSync(out, `${JSON.stringify(draftGraph(JSON.parse(readFileSync(a)), JSON.parse(readFileSync(b))), null, 2)}\n`, { flag: 'wx' });
+  console.log('UNREVIEWED graph draft written; independently verify sources, terminal traces, policies and edges before pinning its SHA256.');
+}
diff --git a/scripts/exact-route-graph.test.mjs b/scripts/exact-route-graph.test.mjs
new file mode 100644
index 0000000000..0d55ea377b
--- /dev/null
+++ b/scripts/exact-route-graph.test.mjs
@@ -0,0 +1,133 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { cohort } from './lib/exact-route-cohort.mjs';
+import { draftGraph, compareReviewedGraph } from './exact-route-graph.mjs';
+import { packageInputs } from './exact-route-inputs.mjs';
+import { sha256 } from './exact-route-source.mjs';
+const receipts = c => c.dirs.map(d => JSON.parse(readFileSync(join(d, 'receipt.json'))));
+function pin(c, change = () => {}) {
+  const witness = draftGraph(...receipts(c)); change(witness);
+  const bytes = JSON.stringify(witness), graphPath = join(c.dirs[1], 'reviewed-graph.json');
+  writeFileSync(graphPath, bytes); return { graphPath, graphSha256: sha256(bytes) };
+}
+test('source-pinned native workspace additions and edges qualify with every unit policy retained', t => {
+  const c = cohort(t, { workspaceGraph: true });
+  assert.throws(() => c.compare());
+  const result = c.compare(pin(c)); assert.equal(result.equal, true);
+  assert.equal(result.graph.added.length, 2);
+  assert.equal(result.graph.sides[0].units, 5); assert.equal(result.graph.sides[1].units, 7);
+});
+test('explicit workspace removal is supported without shrinking provenance requirements', t => {
+  const c = cohort(t, { workspaceGraph: true }), [a, b] = receipts(c);
+  const bytes = JSON.stringify(draftGraph(b, a));
+  const result = compareReviewedGraph(b, a, { bytes }, sha256(bytes));
+  assert.equal(result.removed.length, 2); assert.equal(result.added.length, 0);
+});
+for (const kind of ['args', 'profile', 'features', 'external-source', 'external-args']) {
+  test(`identical captures/example policy cannot waive ${kind} drift even in a re-pinned graph`, t => {
+    const c = cohort(t, { workspaceGraph: true });
+    c.compiler(({ events, artifacts }) => {
+      const i = kind.startsWith('external') ? 0 : artifacts.findIndex(a => a.target.name === 'ifc-lite-geometry');
+      if (kind === 'profile') artifacts[i].profile.opt_level = '0';
+      else if (kind === 'features') artifacts[i].features.push('unexpected');
+      else if (kind === 'external-source') events[i].inputsBefore['lib.rs'] = events[i].inputsAfter['lib.rs'] = 'b'.repeat(64);
+      else events[i].args.push('-C', 'debug-assertions=yes');
+    });
+    assert.throws(() => c.compare(pin(c)));
+  });
+}
+test('changed added-unit compiler arguments cannot reuse the reviewed witness', t => {
+  const c = cohort(t, { workspaceGraph: true }), evidence = pin(c);
+  c.compiler(({ events }) => events.find(e => e.package.name === 'ifc-lite-imported-geometry').args.push('-C', 'opt-level=0'));
+  assert.throws(() => c.compare(evidence), /witness mismatch/);
+});
+test('unknown additions require explicit workspace package ownership authorization', t => {
+  const c = cohort(t, { workspaceGraph: true });
+  assert.throws(() => c.compare(pin(c, w => w.workspacePackages = ['ifc-lite-geometry-runtime'])), /unknown graph addition/);
+});
+for (const mutation of [w => w.sides[1].source.tree = 'a'.repeat(40),
+  w => w.sides[1].units.pop(), w => w.sides[1].units[0].manifestSha256 = 'a'.repeat(64),
+  w => w.sides[1].units.at(-1).links.reverse(), w => w.added.pop()]) {
+  test('independently pinned but false source/unit/edge expectation refuses', t => {
+    const c = cohort(t, { workspaceGraph: true }); assert.throws(() => c.compare(pin(c, mutation)));
+  });
+}
+test('witness bytes require independent digest; receipt labels and edited witnesses cannot authorize', t => {
+  const c = cohort(t, { workspaceGraph: true }), evidence = pin(c);
+  assert.throws(() => c.compare({ graphPath: evidence.graphPath }));
+  writeFileSync(evidence.graphPath, readFileSync(evidence.graphPath, 'utf8') + '\n');
+  assert.throws(() => c.compare(evidence), /digest/);
+});
+test('unlisted external transition refuses; a literal reviewed source/policy transition qualifies', t => {
+  const c = cohort(t, { workspaceGraph: true });
+  c.compiler(({ events }) => events[0].args.push('-C', 'opt-level=2'));
+  assert.throws(() => c.compare(pin(c)), /external source\/policy/);
+  assert.equal(c.compare(pin(c, w => w.externalTransitions = [w.sides[1].units[0].key])).equal, true);
+  const evidence = pin(c, w => w.externalTransitions = [w.sides[1].units[0].key]);
+  c.compiler(({ events }) => events[0].args.push('-C', 'overflow-checks=yes'));
+  assert.throws(() => c.compare(evidence));
+});
+test('source-pinned feature declaration changes preserve enabled-feature and codegen checks', t => {
+  const c = cohort(t, { workspaceGraph: true, featureGraph: true });
+  const before = 'cfg(feature, values("default"))', after = 'cfg(feature, values("default", "triangulation-alt"))';
+  for (const i of [0, 1]) c.compiler(({ events }) => {
+    for (const e of events.filter(e => e.package.name === 'ifc-lite-processing')) e.args.push('--check-cfg', i ? after : before);
+  }, i);
+  assert.throws(() => c.compare(pin(c)), /common workspace compiler policy/);
+  const authorize = w => { w.featureDeclarations = w.sides[0].units.filter(u => u.package === 'ifc-lite-processing').map(u =>
+    ({ unit: u.key, manifest: u.manifestPath, before, after })); };
+  assert.equal(c.compare(pin(c, authorize)).equal, true);
+  c.compiler(({ events }) => events.find(e => e.package.name === 'ifc-lite-processing').args.push('--cfg', 'different_enabled_behavior'));
+  assert.throws(() => c.compare(pin(c, authorize)), /common workspace compiler policy/);
+});
+test('common edge order cannot be normalized away by a reviewed graph', t => {
+  const c = cohort(t, { workspaceGraph: true });
+  c.compiler(({ events }) => {
+    const e = events.at(-1), pairs = [];
+    for (let i = e.args.indexOf('--extern'); i < e.args.length; i += 2) pairs.push(e.args.slice(i, i + 2));
+    e.args.splice(e.args.indexOf('--extern'), pairs.flat().length, ...pairs.reverse().flat());
+  });
+  assert.throws(() => c.compare(pin(c)), /common dependency order/);
+});
+
+test('new external unit requires exact source, policy, owner edge and explicit expected transition', t => {
+  const c = cohort(t, { workspaceGraph: true, externalGraph: true });
+  c.compiler(({ events, artifacts, files, context }) => {
+    const root = join(c.dirs[1], 'external-added-source'); mkdirSync(root);
+    writeFileSync(join(root, 'Cargo.toml'), '[package]\nname = "external-added"\nversion = "1.0.0"\n');
+    writeFileSync(join(root, 'lib.rs'), '// external added source');
+    const event = structuredClone(events[0]), unit = structuredClone(artifacts[0]);
+    event.package = { ...event.package, root, name: 'external-added' };
+    const source = join(root, 'lib.rs'), file = join(c.dirs[1], 'artifacts/libexternal_added-fixture.rlib');
+    writeFileSync(file, 'new external compiler artifact'); files[file] = sha256(readFileSync(file));
+    event.args = ['--crate-name', 'external_added', source, '--out-dir', join(c.dirs[1], 'artifacts'), '--crate-type', 'lib', '-C', 'opt-level=3'];
+    event.inputsBefore = packageInputs(root); event.inputsAfter = structuredClone(event.inputsBefore);
+    event.outputs = { [file]: files[file] };
+    unit.package_id = 'registry+fixture#external-added@1.0.0'; unit.target = { name: 'external-added', kind: ['lib'], src_path: source };
+    unit.filenames = [file]; events.push(event); artifacts.push(unit);
+    const consumer = events.find(e => e.package.name === 'ifc-lite-processing');
+    consumer.args.push('--extern', `external_added=${file}`);
+    consumer.externInputs[file] = consumer.externAfter[file] = files[file];
+    assert.equal(context.source.source, c.branch);
+  });
+  assert.throws(() => c.compare(pin(c)), /unknown graph addition/);
+  const expected = pin(c, w => w.externalTransitions = w.added.filter(k => k.includes('external-added')));
