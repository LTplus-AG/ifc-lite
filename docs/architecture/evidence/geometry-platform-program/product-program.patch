index 0000000000..9de89c5d0c
--- /dev/null
+++ b/rust/geometry/src/program/tests.rs
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: MPL-2.0
+//! ProductProgram phase invariants: source admission precedes child execution,
+//! while conditional descendants observe earlier mutable-decoder callbacks.
+use crate::{GeometryProcessor, GeometryRouter, Mesh, Result, TessellationQuality};
+use crate::processors::BlockProcessor;
+use ifc_lite_core::{DecodedEntity, EntityDecoder, IfcSchema, IfcType};
+use std::{cell::Cell, rc::Rc, sync::Arc};
+
+pub(super) const BLOCK: &str = "#10=IFCBLOCK($,2.,3.,4.);";
+
+pub(super) struct ObservedBlock { pub calls: Rc<Cell<usize>>, pub repair: bool }
+impl GeometryProcessor for ObservedBlock {
+    fn supported_types(&self) -> Vec<IfcType> { vec![IfcType::IfcBlock] }
+    fn process(&self, entity: &DecodedEntity, decoder: &mut EntityDecoder,
+        schema: &IfcSchema, quality: TessellationQuality) -> Result<Mesh> {
+        self.calls.set(self.calls.get() + 1);
+        if self.repair {
+            let repaired = decoder.decode_by_id(10)?;
+            decoder.inject_shared_cache(&[(999, Arc::new(repaired))].into_iter().collect());
+        }
+        BlockProcessor::new().process(entity, decoder, schema, quality)
+    }
+}
+
+fn run(source: &str, styled: bool, repair: bool) -> (Result<usize>, usize) {
+    let calls = Rc::new(Cell::new(0));
+    let mut router = GeometryRouter::new();
+    router.register(Box::new(ObservedBlock { calls: calls.clone(), repair }));
+    let mut decoder = EntityDecoder::new(source);
+    let element = decoder.decode_by_id(1).unwrap();
+    let result = if styled {
+        router.process_element_with_submeshes(&element, &mut decoder)
+            .map(|out| out.sub_meshes.iter().map(|sub| sub.mesh.indices.len() / 3).sum())
+    } else {
+        router.process_element_parts(&element, &mut decoder)
+            .map(|parts| parts.iter().map(|part| part.indices.len() / 3).sum())
+    };
+    (result, calls.get())
+}
+
+#[test]
+fn product_program_bulk_lists_fail_before_the_first_child_in_both_consumers() {
+    for styled in [false, true] {
+        for (reps, items) in [("#3,#999", "#10"), ("#3", "#10,#999")] {
+            let source = format!("{BLOCK}#1=IFCWALL('w',$,$,$,$,$,#2,$);
+                #2=IFCPRODUCTDEFINITIONSHAPE($,$,({reps}));
+                #3=IFCSHAPEREPRESENTATION($,'Body','CSG',({items}));");
+            let (result, calls) = run(&source, styled, true);
+            assert!(result.is_err(), "malformed later reference must fail the whole list");
+            assert_eq!(calls, 0, "an earlier child must not repair a later bulk-list reference");
+        }
+    }
+}
+
+#[test]
+fn product_program_admits_later_representation_items_after_callback_repairs() {
+    let source = format!("{BLOCK}#1=IFCWALL('w',$,$,$,$,$,#2,$);
+        #2=IFCPRODUCTDEFINITIONSHAPE($,$,(#3,#4));
+        #3=IFCSHAPEREPRESENTATION($,'Body','CSG',(#10));
+        #4=IFCSHAPEREPRESENTATION($,'Body','CSG',(#999));");
+    for styled in [false, true] {
+        let (result, calls) = run(&source, styled, true);
+        assert_eq!(result.unwrap(), 24, "both real block occurrences survive");
+        assert_eq!(calls, 2, "later item admission sees the live decoder after the callback");
+    }
+}
+
+#[test]
+fn product_program_skips_axis_and_duplicate_mapped_descendants_without_source_reads() {
+    let source = format!("{BLOCK}#1=IFCWALL('w',$,$,$,$,$,#2,$);
+        #2=IFCPRODUCTDEFINITIONSHAPE($,$,(#4,#5,#3));
+        #3=IFCSHAPEREPRESENTATION($,'Body','CSG',(#10,#10));
+        #4=IFCSHAPEREPRESENTATION($,'Axis','Curve3D',(#998));
+        #5=IFCSHAPEREPRESENTATION($,'Body','MappedRepresentation',(#999));");
+    for styled in [false, true] {
+        let (result, calls) = run(&source, styled, false);
+        assert_eq!(result.unwrap(), 24);
+        assert_eq!(calls, 2, "repeated direct items are occurrences, not a global visited set");
+    }
+}
+
+#[test]
+fn product_program_absent_shape_skips_invalid_placement() {
+    for styled in [false, true] {
+        let (result, calls) = run("#1=IFCWALL('w',$,$,$,$,#999,$,$);", styled, false);
+        assert_eq!(result.unwrap(), 0);
+        assert_eq!(calls, 0);
+    }
+}
+
+#[test]
+fn selected_builtin_constructor_owns_parameters_after_source_disposal() {
+    let plan = {
+        let source = BLOCK.to_owned();
+        let mut decoder = EntityDecoder::new(&source);
+        let entity = decoder.decode_by_id(10).unwrap();
+        BlockProcessor::new().lower_owned(&entity, &mut decoder, TessellationQuality::Medium, None)
+            .expect("selected builtin admits an owned payload").unwrap()
+    };
+    let mesh = plan.evaluate().unwrap();
+    assert_eq!(mesh.indices.len(), 36);
+    for axis in 0..3 {
+        let max = mesh.positions.chunks_exact(3).map(|p| p[axis]).fold(f32::NEG_INFINITY, f32::max);
+        let min = mesh.positions.chunks_exact(3).map(|p| p[axis]).fold(f32::INFINITY, f32::min);
+        assert_eq!((min, max), (0., [2., 3., 4.][axis]));
+    }
+}
diff --git a/rust/geometry/src/program/traversal.rs b/rust/geometry/src/program/traversal.rs
new file mode 100644
index 0000000000..503c3936e1
--- /dev/null
+++ b/rust/geometry/src/program/traversal.rs
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MPL-2.0
+//! One reached representation and one whole admitted item list at a time.
+use crate::representation::{product_shape, Select};
+use crate::Result;
+use super::{ItemProgram, ItemListPolicy};
+use ifc_lite_core::{DecodedEntity, EntityDecoder};
+
+/// Owned item and the selected representation's annotation policy.
+pub(crate) struct ReachedItem {
+    pub item: DecodedEntity,
+    pub fill_only: bool,
+}
+
+/// Representation/item error and filtering policies retained by each entry.
+#[derive(Clone, Copy)]
+pub(crate) enum EntryPolicy { MergedProduct, StyledProduct, TypeMap, OpeningItemMeshes, OpeningItemBounds }
+impl EntryPolicy {
+    fn opening(self) -> bool { matches!(self, Self::OpeningItemMeshes | Self::OpeningItemBounds) }
+}
+
+/// Owns reached control; no decoder or borrowed scope survives `next`.
+/// Descendants of a later item are never admitted early.
+pub(crate) struct ProductProgram {
+    policy: EntryPolicy,
+    element: DecodedEntity,
+    representations: std::vec::IntoIter<DecodedEntity>,
+    items: ItemProgram,
+    fill_only: bool,
+    state: State,
+    resources: super::resources::MergedResources,
+}
+
+enum State { Representations, Items, Complete }
+
+enum SourceAdmission {
+    RepresentationItems(DecodedEntity),
+}
+
+enum AdmissionValue {
+    Items(ItemProgram),
+}
+
+impl ProductProgram {
+    pub(crate) fn admit(element: &DecodedEntity, policy: EntryPolicy, decoder: &mut EntityDecoder<'_>) -> Result<Option<Self>> {
+        let Some(shape) = product_shape(element, decoder)? else { return Ok(None) };
+        Ok(Some(Self::representations(element, policy, shape.into_selected(element, Select::Meshed))))
+    }
+
+    fn representations(element: &DecodedEntity, policy: EntryPolicy, reps: Vec<DecodedEntity>) -> Self {
+        Self { element: element.clone(), policy, representations: reps.into_iter(),
+            items: ItemProgram::empty(), fill_only: false, state: State::Representations,
+            resources: Default::default() }
+    }
+
+    pub(crate) fn opening(element: &DecodedEntity, policy: EntryPolicy, decoder: &mut EntityDecoder<'_>) -> Result<Option<Self>> {
+        debug_assert!(policy.opening());
+        Ok(super::source::opening_representations(element, decoder)?
+            .map(|reps| Self::representations(element, policy, reps)))
+    }
+
+    pub(super) fn type_map(rep_map: &DecodedEntity, representation: &DecodedEntity, decoder: &mut EntityDecoder<'_>) -> Result<Self> {
+        // Whole Items precede the source claim and every child, even for non-Body maps.
+        let items = ItemProgram::admit(representation, decoder, ItemListPolicy::RequiredMap)?;
+        let mut program = Self::representations(rep_map, EntryPolicy::TypeMap, Vec::new());
+        program.items = items;
+        program.state = State::Items;
+        Ok(program)
+    }
+
+    pub(crate) fn merge(&mut self, mesh: crate::Mesh, instancing: bool) {
+        self.resources.merge(mesh, instancing);
+    }
+
+    pub(crate) fn finish_merged(self, instancing: bool) -> super::resources::MergedParts {
+        self.resources.finish(instancing)
+    }
+
+    pub(crate) fn next(&mut self, decoder: &mut EntityDecoder<'_>) -> Result<Option<ReachedItem>> {
+        loop {
+            match self.state {
+                State::Representations => {
+                    let Some(rep) = self.representations.next() else { self.state = State::Complete; continue };
+                    // Historical whole-list admission precedes annotation policy
+                    // and the first child, even if the final child reference fails.
+                    let value = match self.admit_source(SourceAdmission::RepresentationItems(rep.clone()), decoder) {
+                        Ok(value) => value,
+                        Err(_) if self.policy.opening() => continue,
+                        Err(error) => return Err(error),
+                    };
+                    let AdmissionValue::Items(items) = value;
+                    self.fill_only = !self.policy.opening() && crate::router::annotation::is_fill_only_representation(&self.element, &rep);
+                    self.items = items;
+                    self.state = State::Items;
+                }
+                State::Items => match self.items.next() {
+                    Some(item) => return Ok(Some(ReachedItem { item, fill_only: self.fill_only })),
+                    None => self.state = State::Representations,
+                },
+                State::Complete => return Ok(None),
+            }
+        }
+    }
+
+    fn admit_source(&self, request: SourceAdmission, decoder: &mut EntityDecoder<'_>) -> Result<AdmissionValue> {
