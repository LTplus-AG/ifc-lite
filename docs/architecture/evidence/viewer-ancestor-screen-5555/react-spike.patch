+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+import { useIfcLoader } from './useIfcLoader.js';
+import { useIfcFederation } from './useIfcFederation.js';
+
+/** Loading actions without subscribing the caller to the full viewer model state. */
+export function useIfcActions() {
+  const { loadFile } = useIfcLoader();
+  const federation = useIfcFederation(loadFile);
+  return { loadFile, ...federation };
+}
