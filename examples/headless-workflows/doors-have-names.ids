<ids xmlns="http://standards.buildingsmart.org/IDS">
  <info><title>Developer recipe: doors have names</title></info>
  <specifications>
    <specification name="Doors have names" ifcVersion="IFC4" identifier="door-names">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
  </specifications>
</ids>
