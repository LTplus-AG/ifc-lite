{
  "name": "@ifc-lite/a2ui",
  "version": "0.2.0",
  "type": "module",
  "description": "A2UI v1.0 catalog, agent helpers and surface builders for IFC result surfaces",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/web_core": "0.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mergifyio/vitest": "^2026.11.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
