{
  "name": "@ifc-lite/codegen",
  "version": "1.15.12",
  "description": "TypeScript code generator from IFC EXPRESS schemas",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/codegen"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ifc4": {
      "types": "./dist/generated/ifc4/index.d.ts",
      "import": "./dist/generated/ifc4/index.js",
      "default": "./dist/generated/ifc4/index.js"
    },
    "./ifc4x3": {
      "types": "./dist/generated/ifc4x3/index.d.ts",
      "import": "./dist/generated/ifc4x3/index.js",
      "default": "./dist/generated/ifc4x3/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc && pnpm exec tsc -p tsconfig.generated.json",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run",
    "generate": "node dist/cli.js",
    "generate:ifc4": "node dist/cli.js schemas/IFC4_ADD2_TC1.exp -o generated/ifc4",
    "generate:ifc4x3": "node dist/cli.js schemas/IFC4X3.exp -o generated/ifc4x3"
  },
  "keywords": [
    "ifc",
    "express",
    "codegen",
    "typescript"
  ],
  "author": "Louis True",
  "license": "MPL-2.0",
  "dependencies": {
    "@ifc-lite/data": "workspace:^",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "files": [
    "dist",
    "schemas",
    "README.md"
  ]
}
