{
  "name": "@ifc-lite/data",
  "version": "3.2.4",
  "description": "Columnar data structures for IFC-Lite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run",
    "generate:epsg-index": "tsx ../../scripts/generate-epsg-index.ts",
    "augment:epsg-proj4": "tsx ../../scripts/augment-epsg-proj4.ts",
    "verify:epsg": "tsx scripts/verify-epsg-roundtrip.ts",
    "generate:ifc-schema": "tsx scripts/generate-ifc-schema.ts"
  },
  "dependencies": {
    "@ifc-lite/encoding": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "proj4": "^2.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/data"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "data",
    "columnar",
    "aec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
