{
  "name": "@ifc-lite/export",
  "version": "4.13.2",
  "description": "Export formats for IFC-Lite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/codegen": "workspace:^",
    "@ifc-lite/data": "workspace:^",
    "@ifc-lite/encoding": "workspace:^",
    "@ifc-lite/geometry": "workspace:^",
    "@ifc-lite/ifcx": "workspace:^",
    "@ifc-lite/mutations": "workspace:^",
    "@ifc-lite/parser": "workspace:^",
    "apache-arrow": "^21.2.0",
    "fflate": "^0.8.3",
    "parquet-wasm": "^0.9.0"
  },
  "devDependencies": {
    "@ifc-lite/wasm": "workspace:^",
    "@mergifyio/vitest": "^2026.10.11",
    "jszip": "^3.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/export"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "export",
    "gltf",
    "parquet",
    "aec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
