{
  "name": "@ifc-lite/export",
  "version": "6.0.0",
  "description": "Export formats for IFC-Lite",
  "type": "module",
  "sideEffects": [
    "./src/__fixtures__/ifc5-official-schemas.ts",
    "./dist/__fixtures__/ifc5-official-schemas.js",
    "./src/declared-property-type.ts",
    "./dist/declared-property-type.js",
    "./src/entity-subgraph.ts",
    "./dist/entity-subgraph.js",
    "./src/entity-type-sets.ts",
    "./dist/entity-type-sets.js",
    "./src/ifc5-tree-scope.ts",
    "./dist/ifc5-tree-scope.js",
    "./src/merged-empty-containers.ts",
    "./dist/merged-empty-containers.js",
    "./src/merged-inverse-claims.ts",
    "./dist/merged-inverse-claims.js",
    "./src/reference-collector.ts",
    "./dist/reference-collector.js",
    "./src/schema-converter-ifc2x3-slots.ts",
    "./dist/schema-converter-ifc2x3-slots.js",
    "./src/schema-converter-ifc4-slots.ts",
    "./dist/schema-converter-ifc4-slots.js",
    "./src/schema-converter-mep.ts",
    "./dist/schema-converter-mep.js",
    "./src/subset-roots.ts",
    "./dist/subset-roots.js",
    "./src/unit-normalize.ts",
    "./dist/unit-normalize.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./merged-exporter": {
      "types": "./dist/merged-exporter.d.ts",
      "import": "./dist/merged-exporter.js",
      "default": "./dist/merged-exporter.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/codegen": "workspace:^",
    "@ifc-lite/data": "workspace:^",
    "@ifc-lite/encoding": "workspace:^",
    "@ifc-lite/geometry": "workspace:^",
    "@ifc-lite/ifcx": "workspace:^",
    "@ifc-lite/mutations": "workspace:^",
    "@ifc-lite/parser": "workspace:^",
    "apache-arrow": "^21.2.0",
    "fflate": "^0.8.3",
    "parquet-wasm": "^0.9.0"
  },
  "devDependencies": {
    "@ifc-lite/wasm": "workspace:^",
    "@mergifyio/vitest": "^2026.11.8",
    "jszip": "^3.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/export"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "export",
    "gltf",
    "parquet",
    "aec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
