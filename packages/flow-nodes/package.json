{
  "name": "@ifc-lite/flow-nodes",
  "version": "0.7.0",
  "description": "Standard node library for @ifc-lite/flow over the ifc-lite SDK: model reads and writes, tables, viewer, and a sandboxed Script node",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/ai": "workspace:^",
    "@ifc-lite/bcf-api": "workspace:^",
    "@ifc-lite/data": "workspace:^",
    "@ifc-lite/documents-api": "workspace:^",
    "@ifc-lite/export": "workspace:^",
    "@ifc-lite/extensions": "workspace:^",
    "@ifc-lite/flow": "workspace:^",
    "@ifc-lite/mutations": "workspace:^",
    "@ifc-lite/query": "workspace:^",
    "@ifc-lite/sandbox": "workspace:^",
    "@ifc-lite/sdk": "workspace:^",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.17.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/flow-nodes"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "dataflow",
    "node-graph",
    "nodes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
