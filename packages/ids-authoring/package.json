{
  "name": "@ifc-lite/ids-authoring",
  "version": "0.1.0",
  "description": "Headless IDS authoring core: Studio document with stable node ids, typed invertible operations, a grounding gate against the IFC schema tables, history, sidecar and re-identification",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/data": "workspace:*",
    "@ifc-lite/ids": "workspace:*",
    "@ifc-lite/regex-guard": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@ifc-lite/rules": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/ids-authoring"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "ids",
    "buildingsmart",
    "authoring",
    "information-delivery-specification"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
