{
  "name": "@ifc-lite/rules",
  "version": "0.4.1",
  "description": "Filter-rule vocabulary, evaluator and .rules.json information-validation engine for IFC-Lite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "dev": "pnpm exec tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/data": "workspace:*",
    "@ifc-lite/encoding": "workspace:*",
    "@ifc-lite/ids": "workspace:*",
    "@ifc-lite/lens": "workspace:*",
    "@ifc-lite/lists": "workspace:*",
    "@ifc-lite/mutations": "workspace:*",
    "@ifc-lite/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "license": "MPL-2.0",
  "author": "Louis True",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/rules"
  },
  "homepage": "https://ifclite.dev/docs/",
  "bugs": "https://github.com/LTplus-AG/ifc-lite/issues",
  "keywords": [
    "ifc",
    "bim",
    "validation",
    "ids",
    "rules",
    "filter",
    "aec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
