{
  "name": "@ifc-lite/semantic",
  "version": "0.1.0",
  "description": "Portable semantic datasets, profiles, validation and IFC identity resolution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "typecheck": "node ../../scripts/typecheck-tests.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ifc-lite/sandbox": "workspace:^",
    "@ifc-lite/extensions": "workspace:^",
    "@traqula/parser-sparql-1-1": "^1.3.1",
    "ajv": "^8.17.1",
    "jsonld": "^9.0.0",
    "n3": "^2.0.3",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "^26.6.2"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LTplus-AG/ifc-lite.git",
    "directory": "packages/semantic"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
