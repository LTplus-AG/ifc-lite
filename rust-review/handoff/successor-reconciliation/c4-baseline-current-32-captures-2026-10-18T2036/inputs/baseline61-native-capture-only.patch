+// SPDX-License-Identifier: MPL-2.0
+//! Dedicated ignored test adapter; SOURCE ONLY, never run by preparation.
+//!
+//! Baseline61 source notes relocated from processor/mod.rs; original ordinary
+//! construction/handoff logic remains there and in final resolve.rs.
+//!
+//! C — entity-index construction
+//! The entity index (expressId -> byte span) is built INLINE in the scan loop
+//! below rather than in a separate `build_entity_index` pass, so the file is
+//! walked once instead of twice. A caller that injected an index reuses it and
+//! skips the inline build. `decode_at` during the scan needs no index (it parses
+//! local bytes), so the scan-phase decoder starts index-less; the completed
+//! index is installed before the first ref-resolving call (`resolve_prepass`).
+//!
+//! D — completed-index handoff
+//! The inline index is now complete — identical to `build_entity_index` over
+//! the same scanner. Install it into the decoder so `resolve_prepass` and the
+//! downstream phases resolve refs against it, and expose it (as before) to the
+//! geometry workers further down.
+use super::{EntityJob, process_geometry};
+use crate::c4_parity_observer as obs;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::io::Write;
+// Used by the observed alternative; capture-only intentionally has no hooks.
+#[allow(dead_code)]
+pub(super) fn jobs(stage: &str, jobs: &[EntityJob]) {
+    obs::record(json!({"event":"native_jobs","stage":stage,"jobs":jobs.iter().map(|j|json!({
+      "id":j.id,"ifcType":j.ifc_type.to_string(),"start":j.start,"end":j.end,
+      "representationMapId":j.representation_map_id,"shapeId":j.product_definition_shape_id,
+      "elementColor":obs::f32s(&j.element_color),"globalId":j.global_id,"name":j.name,
+      "presentationLayer":j.presentation_layer,"properties":j.space_zone_properties,
+    })).collect::<Vec<_>>()}));
+}
+#[test]
+#[ignore = "C4-0 explicit one-case harness; requires later approved owned execution"]
+fn capture_one() {
+    let required = |n| std::env::var(n).unwrap_or_else(|_|panic!("required {n}"));
+    let input = required("C4_PARITY_INPUT"); let output = required("C4_PARITY_OUTPUT");
+    let token = required("C4_PARITY_TOKEN"); let source = required("C4_PARITY_SOURCE");
+    let observer = required("C4_PARITY_OBSERVE") == "on";
+    let contract: Value = serde_json::from_str(&required("C4_PARITY_CONTRACT")).expect("explicit reviewed work contract");
+    let content = std::fs::read(input).expect("read exact immutable input");
+    let digest = format!("{:x}",Sha256::digest(&content));
+    assert_eq!(digest,required("C4_PARITY_INPUT_SHA256"));
+    // Dedicated process only: same setting as the shipped wasm path. It is
+    // explicitly recorded; no attempt to restore a process-global flag mid-load.
+    ifc_lite_geometry::local_frame_set_enabled_override(Some(true));
+    if observer { obs::begin(&token).expect("arm own observer"); }
+    // Exactly ONE actual public invocation; do not call resolve separately.
+    let result = std::panic::catch_unwind(||process_geometry(&content));
+    let observations = if observer {obs::take(&token)} else {Ok(Vec::new())};
+    let receipt: Value = match result {
+      Ok(r) => json!({"schema":"c4-0-native-v1","status":"captured_unvalidated",
+        "source":source,"contract":contract,"input":{"sha256":digest,"bytes":content.len()},
+        "mode":{"entry":"process_geometry","localFrame":true,"quality":"Medium","opening":"Default","instancing":false},
+        "observationEnabled":observer,"observations":observations.as_ref().ok(),
+        "observationError":observations.as_ref().err(),
+        "raw":{"meshes":r.meshes.iter().map(obs::mesh).collect::<Vec<_>>(),"stats":r.stats,
+          "metadata":r.metadata,"metadataFloatBits":{"originShift":obs::f64s(&r.metadata.coordinate_info.origin_shift),"lengthUnitScale":r.metadata.length_unit_scale.map(|v|obs::f64s(&[v]))},"refusals":{"input":r.stats.refused_input_elements,"prepass":r.stats.refused_prepass_records},"frameDebug":format!("{:?}",r.frame),
+          "frameToWorld":obs::f64s(&r.frame.world_matrix()),
+          "rtcOffset":obs::f64s(&[r.frame.rtc_offset().0,r.frame.rtc_offset().1,r.frame.rtc_offset().2]),
+          "coordinateSpace":r.mesh_coordinate_space,"siteTransform":r.site_transform.as_ref().map(|v|obs::f64s(v)),
+          "buildingTransform":r.building_transform.as_ref().map(|v|obs::f64s(v)),
+          "instancesDebug":format!("{:?}",r.instances)}}),
+      Err(_) => json!({"schema":"c4-0-native-v1","status":"incomplete","source":source,
+        "input":{"sha256":digest,"bytes":content.len()},"error":"public native invocation panicked",
+        "observations":observations.ok()}),
+    };
+    let mut f=std::fs::OpenOptions::new().write(true).create_new(true).open(output).expect("exclusive receipt");
+    f.write_all(serde_json::to_string_pretty(&receipt).expect("serialize receipt").as_bytes()).expect("write receipt");
+    assert_eq!(receipt["status"],"captured_unvalidated");
+    assert!(receipt["observationError"].is_null());
+}
