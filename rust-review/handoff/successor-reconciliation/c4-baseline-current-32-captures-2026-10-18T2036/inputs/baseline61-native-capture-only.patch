+// SPDX-License-Identifier: MPL-2.0
+//! Harness-only primitive observations. Never compiled in ordinary release.
+//! One armed invocation per dedicated process/wasm realm; no re-resolution.
+use serde_json::{json, Value};
+use std::sync::{Mutex, OnceLock};
+#[derive(Default)]
+struct State { token: String, events: Vec<Value> }
+fn slot() -> &'static Mutex<Option<State>> {
+    static SLOT: OnceLock<Mutex<Option<State>>> = OnceLock::new();
+    SLOT.get_or_init(|| Mutex::new(None))
+}
+pub fn begin(token: &str) -> Result<(), String> {
+    let mut s = slot().lock().map_err(|e| e.to_string())?;
+    if s.is_some() { return Err("C4 observer already armed; no nested/replacement capture".into()); }
+    *s = Some(State { token: token.into(), events: Vec::new() }); Ok(())
+}
+pub fn take(token: &str) -> Result<Vec<Value>, String> {
+    let mut s = slot().lock().map_err(|e| e.to_string())?;
+    if s.as_ref().map(|v| v.token.as_str()) != Some(token) {
+        return Err("C4 observer token/ownership mismatch".into());
+    }
+    Ok(s.take().expect("checked owned state").events)
+}
+pub fn record(event: Value) {
+    // Poison is an incomplete capture, never silently repaired or accepted.
+    let mut s = slot().lock().expect("C4 observer poisoned");
+    if let Some(s) = s.as_mut() { s.events.push(event); }
+}
+fn wire(kind: &str, length: usize, bytes: Vec<u8>) -> Value {
+    let hex: String = bytes.iter().map(|b| format!("{b:02x}")).collect();
+    json!({"typedArray":kind,"length":length,"byteLength":bytes.len(),"bytesHex":hex})
+}
+pub fn f32s(v: &[f32]) -> Value {
+    wire("Float32Array", v.len(), v.iter().flat_map(|x| x.to_bits().to_le_bytes()).collect())
+}
+pub fn f64s(v: &[f64]) -> Value {
+    wire("Float64Array", v.len(), v.iter().flat_map(|x| x.to_bits().to_le_bytes()).collect())
+}
+pub fn u32s(v: &[u32]) -> Value {
+    wire("Uint32Array", v.len(), v.iter().flat_map(|x| x.to_le_bytes()).collect())
+}
+pub fn u8s(v: &[u8]) -> Value { wire("Uint8Array",v.len(),v.to_vec()) }
+pub fn element_job(job: &crate::element::ElementMeshJob<'_>) {
+    let maps = match &job.kind {
+        crate::element::ElementJobKind::Product => Vec::new(),
+        crate::element::ElementJobKind::TypeProduct { rep_maps } => rep_maps.clone(),
+    };
+    record(json!({"event":"element_job","id":job.id,"ifcType":job.ifc_type.to_string(),
+      "kind":if maps.is_empty(){"product"}else{"type"},"repMaps":maps,
+      "suppliedElementColor":job.element_color.map(|v| f32s(&v))}));
+}
+pub fn mesh(m: &crate::MeshData) -> Value {
+    // Preserve every Rust field plus exact binary arrays skipped by serde.
+    // serde text is supplementary; float identity comes from explicit wires.
+    json!({"id":m.express_id,"ifcType":m.ifc_type,"geometryClass":m.geometry_class,
+      "geometryItemId":m.geometry_item_id,"materialId":m.material_id,
+      "positions":f32s(&m.positions),"normals":f32s(&m.normals),"indices":u32s(&m.indices),
+      "color":f32s(&m.color),"origin":f64s(&m.origin),
+      "localBounds":m.local_bounds.map(|v|f32s(&v)),
+      "localToWorld":m.local_to_world.map(|v|f64s(&v)),
+      "uvs":m.uvs.as_ref().map(|v|f32s(v)),
+      "texture":m.texture.as_ref().map(|t|json!({"id":t.texture_id,"width":t.width,"height":t.height,
+        "repeatS":t.repeat_s,"repeatT":t.repeat_t,"url":t.url,
+        "rgba":t.rgba.as_ref().map(|v|u8s(v))})),
+      "nativeFields":m})
+}
