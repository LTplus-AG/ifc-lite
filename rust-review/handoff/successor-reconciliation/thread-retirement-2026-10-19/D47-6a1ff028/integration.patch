+# SPDX-License-Identifier: MPL-2.0
+"""D47/#7895: public wheel consumer of the normative complex budget vectors.
+
+The Rust public-consumer regression compares the same pins with canonical
+server extraction. No geometry or alternate property decoder runs here.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+import ifclite_geom
+import pytest
+
+REPO = Path(__file__).resolve().parents[3]
+VECTOR = REPO / "packages/parser/test/fixtures/complex-property-budget-7675.json"
+MARKER = "(truncated: nested properties over the walk budget)"
+
+
+def budget_case(name):
+    cases = json.loads(VECTOR.read_text())["cases"]
+    return next(case for case in cases if case["name"] == name)
+
+
+def fixture(case):
+    lines = []
+    for line in case["dataLines"]:
+        if isinstance(line, str):
+            lines.append(line)
+        else:
+            for i in range(line["from"], line["from"] + line["count"]):
+                lines.extend(text.replace("{i}", str(i)) for text in line["repeat"])
+    return ("ISO-10303-21;\nHEADER;\nFILE_SCHEMA(('IFC4'));\nENDSEC;\nDATA;\n"
+            + "\n".join(lines) + "\nENDSEC;\nEND-ISO-10303-21;\n").encode()
+
+
+def assert_pins(row, case):
+    sets = row["property_sets"]
+    assert [s["name"] for s in sets] == [s["name"] for s in case["psets"]]
+    for pset, pin in zip(sets, case["psets"]):
+        values = [p["value"] for p in pset["properties"]]
+        assert len(values) == pin["count"]
+        if "values" in pin:
+            assert values == pin["values"]
+        else:
+            joined = "\n".join(values).encode()
+            assert len(joined) == pin["length"]
+            assert hashlib.sha256(joined).hexdigest() == pin["sha256"]
+
+
+def test_issue_7895_all_shared_occurrences_keep_the_one_canonical_value():
+    case = budget_case("shared-set")
+    assert case["cuts"] == 1  # The legitimate original cut remains allowed.
+    data = ifclite_geom.entity_data(fixture(case))
+    rows = data["entities"]
+    assert list(rows) == case["entityIds"]
+    first = rows[case["entityIds"][0]]["property_sets"]
+    assert_pins(rows[case["entityIds"][0]], case)
+    assert len(rows) == 200
+    for row in rows.values():
+        assert row["property_sets"] == first
+
+
+def test_issue_7895_distinct_set_exhaustion_and_keep_last_records():
+    for name in ("unnamed-member", "duplicated-set-record", "duplicate-records-differ"):
+        case = budget_case(name)
+        data = ifclite_geom.entity_data(fixture(case))
+        assert len(data["entities"]) == 1
+        for row in data["entities"].values():
+            assert_pins(row, case)
+            if name == "unnamed-member":
+                assert row["property_sets"][-1]["properties"][0]["value"] == MARKER
+
+
+ORDER = json.loads((REPO / "rust/export/tests/fixtures/shared_set_order_7895.json").read_text())
+
+
+def order_input(case):
+    lines = []
+    for line in budget_case("shared-set")["dataLines"]:
+        if line.startswith("#40="):
+            continue
+        is_set = line.startswith("#30=")
+        if is_set and case["shadow"]:
+            lines.append(ORDER["shadowSet"])
+        lines.append(line)
+        if is_set:
+            lines.extend([ORDER["secondSet"], *case["types"]])
+    lines.extend(case["relationships"])
+    return ("ISO-10303-21;\nHEADER;\nFILE_SCHEMA(('IFC4'));\nENDSEC;\nDATA;\n"
+            + "\n".join(lines) + "\nENDSEC;\nEND-ISO-10303-21;\n").encode()
+
+
+def canonical_value(value, set_name):
+    if set_name == "Pset_Second":
+        assert value == MARKER
+    else:
+        assert set_name == "Pset_Shared"
+        pin = budget_case("shared-set")["psets"][0]
+        assert len(value.encode()) == pin["length"]
+        assert hashlib.sha256(value.encode()).hexdigest() == pin["sha256"]
+
+
+@pytest.mark.parametrize("case", ORDER["cases"], ids=lambda case: case["name"])
+@pytest.mark.parametrize("type_properties", [False, True])
+def test_issue_7895_canonical_source_order_independent_of_type_options(case, type_properties):
+    data = ifclite_geom.entity_data(order_input(case), type_properties=type_properties, attributes=False)
+    ids = list(range(100, 300)) + ([803] if case["rowCount"] == 201 else [])
+    assert list(data["entities"]) == ids
+    shape = dict(case["inherited" if type_properties else "own"])
+    for entity_id, row in data["entities"].items():
+        assert [ps["name"] for ps in row["property_sets"]] == shape.get(entity_id, [])
+        for pset in row["property_sets"]:
+            assert len(pset["properties"]) == 1
+            assert pset["properties"][0]["name"] == "Wide"
+            canonical_value(pset["properties"][0]["value"], pset["name"])
+
+
+def test_issue_7895_unlinked_and_malformed_members_keep_canonical_charges():
+    case = ORDER["cases"][1]
+    raw = order_input(case).decode()
+    unlinked = raw.replace(case["relationships"][0], "").encode()
+    data = ifclite_geom.entity_data(unlinked)
+    assert data["entities"][100]["property_sets"][0]["properties"][0]["value"] == MARKER
+    assert data["entities"][101]["property_sets"] == []
+    typed = ORDER["cases"][5]
+    own_second = order_input(typed).decode().replace("'Inherited',$,$,(#31)", "'Inherited',$,$,(#30)")
+    own_second = own_second.replace(typed["relationships"][1], typed["relationships"][1].replace(",#30);", ",#31);"))
+    for inherit in [False, True]:
+        data = ifclite_geom.entity_data(own_second.encode(), type_properties=inherit)
+        assert data["entities"][101]["property_sets"][0]["properties"][0]["value"] == MARKER
+    invalid = next(line for line in budget_case("shared-set")["dataLines"] if line.startswith("#22="))
+    invalid = invalid.replace("#22=IFCCOMPLEXPROPERTY('Wide',", "#23=IFCCOMPLEXPROPERTY($,", 1)
+    malformed = raw.replace("'Pset_Shared',$,(#22)", "'Pset_Shared',$,($,#999999,#1,#23,#22,#22)")
+    malformed = malformed.replace("'Pset_Second',$,(#22)", "'Pset_Second',$,(#999999,#22)")
+    malformed = malformed.replace("\nENDSEC;\nEND-ISO", f"\n{invalid}\nENDSEC;\nEND-ISO")
+    data = ifclite_geom.entity_data(malformed.encode())
+    second = data["entities"][100]["property_sets"][0]
+    first = data["entities"][101]["property_sets"][0]
+    assert second["name"] == "Pset_Second" and len(second["properties"]) == 1
+    assert second["properties"][0]["value"] == MARKER
+    assert first["name"] == "Pset_Shared" and len(first["properties"]) == 2
+    canonical_value(first["properties"][0]["value"], first["name"])
+    assert first["properties"][1]["value"] == MARKER
