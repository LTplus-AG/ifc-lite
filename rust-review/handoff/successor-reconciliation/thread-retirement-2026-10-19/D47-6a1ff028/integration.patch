+#[test]
+fn issue_7895_canonical_unlinked_and_malformed_members_still_spend() {
+    let case = &order_cases()["cases"][1];
+    let input = order_input(case);
+    let unlinked = input.replace(case["relationships"][0].as_str().unwrap(), "");
+    let server = order_server(&unlinked);
+    let model = build_export_model(unlinked.as_bytes());
+    assert_eq!(model.entities[0].lookup("Pset_Second", "Wide").as_deref(), Some(order_value(&server, "Pset_Second")));
+    assert!(model.entities[1].property_sets.is_empty());
+    // An earlier type-only set still spends when inheritance is disabled.
+    let typed = &order_cases()["cases"][5];
+    let own_second = order_input(typed).replace("'Inherited',$,$,(#31)", "'Inherited',$,$,(#30)")
+        .replace(typed["relationships"][1].as_str().unwrap(),
+            &typed["relationships"][1].as_str().unwrap().replace(",#30);", ",#31);"));
+    let server = order_server(&own_second);
+    for inherit in [false, true] {
+        let opts = ModelOptions::default().with_inherit_type_properties(inherit);
+        let model = build_export_model_with_options(own_second.as_bytes(), &opts);
+        assert_eq!(model.entities[1].lookup("Pset_Second", "Wide").as_deref(), Some(order_value(&server, "Pset_Second")));
+    }
+    // Non-ref, dangling ref and non-property are skipped individually. Raw
+    // positions and duplicated valid memberships still pay separately.
+    let vector = vector_case("shared-set");
+    let invalid = vector["dataLines"].as_array().unwrap().iter().filter_map(Value::as_str)
+        .find(|line| line.starts_with("#22=")).unwrap()
+        .replacen("#22=IFCCOMPLEXPROPERTY('Wide',", "#23=IFCCOMPLEXPROPERTY($,", 1);
+    let malformed = input.replace("'Pset_Shared',$,(#22)", "'Pset_Shared',$,($,#999999,#1,#23,#22,#22)")
+        .replace("'Pset_Second',$,(#22)", "'Pset_Second',$,(#999999,#22)")
+        .replace("\nENDSEC;\nEND-ISO", &format!("\n{invalid}\nENDSEC;\nEND-ISO"));
+    let server = order_server(&malformed);
+    assert_eq!(server.property_sets[0].properties.len(), 2);
+    assert_eq!(server.property_sets[0].properties[1].property_value, COMPLEX_PROPERTY_BUDGET_MARKER);
+    let model = build_export_model(malformed.as_bytes());
+    for row in &model.entities {
+        for set in &row.property_sets {
+            let canonical = server.property_sets.iter().find(|s| s.pset_name == set.name).unwrap();
+            assert_eq!(set.properties.iter().map(|p| &p.value).collect::<Vec<_>>(),
+                canonical.properties.iter().map(|p| &p.property_value).collect::<Vec<_>>());
+        }
+    }
+    assert_eq!(model.entities[0].property_sets.len(), 1);
+    assert_eq!(model.entities[1].property_sets[0].properties.len(), 2);
+    assert_csv(malformed.as_bytes(), &server, 3);
+    let opts = JsonLdOptions { included: vec![100, 101], ..Default::default() };
+    let doc: Value = serde_json::from_str(&export_jsonld(malformed.as_bytes(), &opts)).unwrap();
+    let mut count = 0;
+    for node in doc["@graph"].as_array().unwrap() {
+        for set in node["ifc:hasPropertySets"].as_array().unwrap() {
+            let canonical = server.property_sets.iter().find(|s| s.pset_name == set["ifc:name"].as_str().unwrap()).unwrap();
+            let props = set["ifc:hasProperties"].as_array().unwrap();
+            assert_eq!(props.len(), canonical.properties.len());
+            for (prop, expected) in props.iter().zip(&canonical.properties) {
+                assert_eq!(prop["@type"], "ifc:IfcComplexProperty");
+                assert_eq!(prop["ifc:nominalValue"], expected.property_value);
+                count += 1;
+            }
+        }
+    }
+    assert_eq!(count, 3);
+}
