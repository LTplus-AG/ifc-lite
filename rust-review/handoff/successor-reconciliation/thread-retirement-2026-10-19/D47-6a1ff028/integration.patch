index 0000000000..ca1637ccff
--- /dev/null
+++ b/rust/processing/src/data_model/property_budget.rs
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MPL-2.0
+//! Canonical complex-membership admission, shared by tables and row projections.
+use super::properties::extract_property;
+use super::property_value::{resolve_complex_property_value, spent_listing};
+use super::types::{EntityJob, Property};
+use ifc_lite_core::limits::{complex_property_listing_bytes, ComplexPropertyBudget};
+use ifc_lite_core::{slot, DecodedEntity, EntityDecoder, EntityIndex, IfcType};
+use std::borrow::Borrow;
+use std::collections::HashMap;
+
+// The existing row-decoder cap, also used during canonical admission. Decisions
+// below have a separate, non-evictable lifetime; clearing entities cannot recharge.
+pub(super) const PSET_CACHE_CAP: usize = 1 << 18;
+pub(super) type ComplexListing = (String, String, Option<String>, Option<Vec<String>>);
+pub(super) type ComplexMemo = HashMap<u32, (ComplexListing, usize)>;
+pub(super) type SetListingMemo = HashMap<(u32, usize), ComplexListing>;
+
+/// Preserve incoming source order, admitting only canonical LAST set records.
+/// Tables pass their existing job bucket; streaming passes a lazy source scan.
+pub(super) fn canonical_sets<'source: 'scan, 'scan, J>(
+    jobs: impl Iterator<Item = J> + 'scan, index: &'scan EntityIndex,
+) -> impl Iterator<Item = J> + 'scan
+where
+    J: Borrow<EntityJob<'source>> + 'scan,
+{
+    jobs.filter(move |candidate| {
+        let job: &EntityJob<'source> = candidate.borrow();
+        job.type_name.eq_ignore_ascii_case("IFCPROPERTYSET")
+            && index.get(&job.id).is_some_and(|&(start, _)| start == job.start)
+    })
+}
+
+/// One membership validity/order rule: skip failed refs individually, preserving
+/// raw HasProperties positions (including non-refs, omitted and duplicate members).
+pub(super) fn visit_members(
+    def: &DecodedEntity, decoder: &mut EntityDecoder,
+    mut visit: impl FnMut(usize, &DecodedEntity, &mut EntityDecoder),
+) {
+    let members = def.attr(slot::IfcPropertySet::HAS_PROPERTIES).and_then(|v| v.as_list()).unwrap_or(&[]);
+    for (position, member) in members.iter().enumerate() {
+        let Some(id) = member.as_entity_ref() else { continue };
+        let Ok(entity) = decoder.decode_by_id(id) else { continue };
+        visit(position, &entity, decoder);
+    }
+}
+
+/// Only complex values depend on the model budget. Validate through the existing
+/// property decoder before spending; an unnamed nested member still costs its
+/// walk, while an invalid top-level property is omitted just as in the tables.
+pub(super) fn admit_complex_set(
+    def: &DecodedEntity, decoder: &mut EntityDecoder,
+    budget: &mut ComplexPropertyBudget, memo: &mut ComplexMemo,
+    mut admit: impl FnMut(usize, ComplexListing),
+) {
+    visit_members(def, decoder, |position, entity, decoder| {
+        if entity.ifc_type == IfcType::IfcComplexProperty && extract_property(entity, decoder).is_some() {
+            admit(position, resolve_listing(entity, decoder, budget, memo));
+        }
+    });
+}
+
+/// The original listing/resolve/charge policy, once per canonical membership.
+/// Distinct sets and duplicate member positions still pay for retained listings.
+pub(super) fn resolve_listing(
+    entity: &DecodedEntity, decoder: &mut EntityDecoder,
+    budget: &mut ComplexPropertyBudget, memo: &mut ComplexMemo,
+) -> ComplexListing {
+    budget.listing(memo, entity.id, |budget| {
+        let resolved = resolve_complex_property_value(entity, decoder, budget);
+        let bytes = complex_property_listing_bytes(&resolved.0, resolved.3.as_deref().unwrap_or_default());
+        (resolved, bytes)
+    }, spent_listing)
+}
+
+pub(super) fn apply_listing(property: &mut Property, (value, kind, data_type, values): ComplexListing) {
+    property.property_value = value;
+    property.property_type = kind;
+    property.data_type = data_type;
+    property.values = values;
+}
