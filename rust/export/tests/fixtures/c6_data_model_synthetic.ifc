ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('C6-0 data-model synthetic'),'2;1');
FILE_NAME('c6_data_model_synthetic.ifc','2026-01-01T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Pinned by the server route golden and the export golden (C6-0, #7783).
   Lowercase keywords, a duplicate #50, every property kind, every quantity
   kind, every material shape, an occurrence typed twice, and 1.E400 values. */
#1=IFCPROJECT('0PROJ00000000000000001',$,'Synthetic',$,$,$,$,(#2),#3);
#2=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0E-5,#5,$);
#3=IFCUNITASSIGNMENT((#6,#7));
#4=IFCCARTESIANPOINT((0.,0.,0.));
#5=IFCAXIS2PLACEMENT3D(#4,$,$);
#6=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#7=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#40=IFCLOCALPLACEMENT($,#5);
#10=IFCSITE('0SITE00000000000000010',$,'Site',$,$,#40,$,$,.ELEMENT.,$,$,$,$,$);
#11=IFCBUILDING('0BLDG00000000000000011',$,'Building',$,$,#40,$,$,.ELEMENT.,$,$,$);
#12=IFCBUILDINGSTOREY('0STOR00000000000000012',$,'Level 0',$,$,#40,$,$,.ELEMENT.,0.);
#13=IFCRELAGGREGATES('0AGG00000000000000013',$,$,$,#1,(#10));
#14=IFCRELAGGREGATES('0AGG00000000000000014',$,$,$,#10,(#11));
#15=IFCRELAGGREGATES('0AGG00000000000000015',$,$,$,#11,(#12));
#16=IFCRELCONTAINEDINSPATIALSTRUCTURE('0CONT0000000000000016',$,$,$,(#310,#320,#330),#12);

/* body geometry shared by the walls */
#300=IFCCARTESIANPOINT((0.,0.));
#301=IFCAXIS2PLACEMENT2D(#300,$);
#302=IFCRECTANGLEPROFILEDEF(.AREA.,$,#301,1.0,0.2);
#303=IFCDIRECTION((0.,0.,1.));
#304=IFCEXTRUDEDAREASOLID(#302,#5,#303,3.0);
#305=IFCSHAPEREPRESENTATION(#2,'Body','SweptSolid',(#304));
#306=IFCPRODUCTDEFINITIONSHAPE($,$,(#305));

/* occurrences: #310 typed twice, #320 typed once, #330 uses lowercase keywords */
#310=IFCWALL('0WALL00000000000000310',$,'Double typed',$,'Generic',#40,#306,'T310',.STANDARD.);
#320=IFCWALL('0WALL00000000000000320',$,'Single typed',$,$,#40,#306,$,$);
#330=ifcwall('0WALL00000000000000330',$,'lowercase wall',$,$,#40,#306,$,$);

/* two wall types; type A carries the inherited sets */
#350=IFCWALLTYPE('0TYPE00000000000000350',$,'Type A',$,$,(#400,#420),$,$,$,.STANDARD.);
#351=IFCWALLTYPE('0TYPE00000000000000351',$,'Type B',$,$,(#401),$,$,$,.SOLIDWALL.);
#352=IFCRELDEFINESBYTYPE('0DBT00000000000000352',$,$,$,(#310,#320),#350);
#353=IFCRELDEFINESBYTYPE('0DBT00000000000000353',$,$,$,(#310),#351);

/* property kinds */
#400=IFCPROPERTYSET('0PSET00000000000000400',$,'Pset_AllKinds',$,(#500,#501,#502,#503,#504,#505,#506,#507,#508,#509));
#401=IFCPROPERTYSET('0PSET00000000000000401',$,'Pset_TypeB',$,(#510));
#402=IFCPROPERTYSET('0PSET00000000000000402',$,'Pset_Occurrence',$,(#511,#512));
#403=IFCPROPERTYSET('0PSET00000000000000403',$,'Pset_NonFinite',$,(#513,#514,#515));
#420=IFCELEMENTQUANTITY('0QTO000000000000000420',$,'Qto_AllKinds',$,$,(#520,#521,#522,#523,#524,#525,#526));
#421=IFCELEMENTQUANTITY('0QTO000000000000000421',$,'Qto_NonFinite',$,$,(#527));
#500=IFCPROPERTYSINGLEVALUE('Text',$,IFCLABEL('Fire \X2\00E4\X0\ proof'),$);
#501=IFCPROPERTYSINGLEVALUE('Flag',$,IFCBOOLEAN(.T.),$);
#502=IFCPROPERTYSINGLEVALUE('Unknown',$,IFCLOGICAL(.U.),$);
#503=IFCPROPERTYSINGLEVALUE('Thickness',$,IFCPOSITIVELENGTHMEASURE(0.2),$);
#504=IFCPROPERTYENUMERATEDVALUE('Status',$,(IFCLABEL('NEW'),IFCLABEL('EXISTING')),$);
#505=IFCPROPERTYBOUNDEDVALUE('Range',$,IFCLENGTHMEASURE(5.),IFCLENGTHMEASURE(1.),$,IFCLENGTHMEASURE(2.));
#506=IFCPROPERTYLISTVALUE('Sizes',$,(IFCINTEGER(1),IFCINTEGER(2),IFCINTEGER(3)),$);
#507=IFCPROPERTYTABLEVALUE('Curve',$,(IFCREAL(0.),IFCREAL(1.)),(IFCREAL(10.),IFCREAL(20.)),$,$,$,.CONTINUOUS.);
#508=IFCPROPERTYREFERENCEVALUE('Ref',$,'Usage',#30);
#509=IFCCOMPLEXPROPERTY('Complex',$,'Usage',(#516,#517));
#510=IFCPROPERTYSINGLEVALUE('TypeOnly',$,IFCLABEL('from type B'),$);
#511=IFCPROPERTYSINGLEVALUE('Text',$,IFCLABEL('occurrence wins'),$);
#512=IFCPROPERTYSINGLEVALUE('OccurrenceOnly',$,IFCINTEGER(7),$);
#513=IFCPROPERTYSINGLEVALUE('HugeReal',$,IFCREAL(1.E400),$);
#514=IFCPROPERTYSINGLEVALUE('HugeNegativeLength',$,IFCLENGTHMEASURE(-1.E400),$);
#515=IFCPROPERTYSINGLEVALUE('Finite',$,IFCREAL(1.5),$);
#516=IFCPROPERTYSINGLEVALUE('Inner1',$,IFCLABEL('a'),$);
#517=IFCPROPERTYSINGLEVALUE('Inner2',$,IFCREAL(2.5),$);
#520=IFCQUANTITYLENGTH('Length',$,$,3.,$);
#521=IFCQUANTITYAREA('Area',$,$,12.5,$);
#522=IFCQUANTITYVOLUME('Volume',$,$,0.6,$);
#523=IFCQUANTITYCOUNT('Count',$,$,4.,$);
#524=IFCQUANTITYWEIGHT('Weight',$,$,100.,$);
#525=IFCQUANTITYTIME('Time',$,$,2.,$);
#526=IFCQUANTITYNUMBER('Number',$,$,9.,$);
#527=IFCQUANTITYLENGTH('Huge',$,$,1.E400,$);
#30=IFCPROPERTYSINGLEVALUE('Target',$,IFCLABEL('referenced'),$);
#50=IFCPROPERTYSINGLEVALUE('Dup',$,IFCLABEL('first #50'),$);
#50=IFCPROPERTYSINGLEVALUE('Dup',$,IFCLABEL('second #50'),$);
#404=IFCPROPERTYSET('0PSET00000000000000404',$,'Pset_Duplicate',$,(#50));

#600=IFCRELDEFINESBYPROPERTIES('0RDP00000000000000600',$,$,$,(#310),#402);
#601=IFCRELDEFINESBYPROPERTIES('0RDP00000000000000601',$,$,$,(#330),#403);
#602=IFCRELDEFINESBYPROPERTIES('0RDP00000000000000602',$,$,$,(#330),#421);
#603=IFCRELDEFINESBYPROPERTIES('0RDP00000000000000603',$,$,$,(#320),#404);
#604=ifcreldefinesbyproperties('0RDP00000000000000604',$,$,$,(#330),#400);

/* materials: layer set + usage, profile set, constituent set, list */
#700=IFCMATERIAL('Concrete',$,'Concrete');
#701=IFCMATERIAL('Insulation',$,'Insulation');
#702=IFCMATERIALLAYER(#700,0.15,.F.,'Core',$,$,$);
#703=IFCMATERIALLAYER(#701,0.05,.F.,'Insulation',$,$,$);
#704=IFCMATERIALLAYERSET((#702,#703),'Wall build-up',$);
#705=IFCMATERIALLAYERSETUSAGE(#704,.AXIS2.,.POSITIVE.,0.,$);
#706=IFCMATERIALPROFILE('Flange',$,#700,#302,$,$);
#707=IFCMATERIALPROFILESET('Profile set',$,(#706),$);
#708=IFCMATERIALCONSTITUENT('Skin',$,#701,0.3,$);
#709=IFCMATERIALCONSTITUENTSET('Constituents',$,(#708));
#710=IFCMATERIALLIST((#700,#701));
#711=IFCRELASSOCIATESMATERIAL('0MAT00000000000000711',$,$,$,(#310),#705);
#712=IFCRELASSOCIATESMATERIAL('0MAT00000000000000712',$,$,$,(#320),#707);
#713=IFCRELASSOCIATESMATERIAL('0MAT00000000000000713',$,$,$,(#330),#709);
#714=IFCRELASSOCIATESMATERIAL('0MAT00000000000000714',$,$,$,(#350),#710);

/* classification */
#800=IFCCLASSIFICATION('CRB',$,$,'eBKP-H',$,$,$);
#801=IFCCLASSIFICATIONREFERENCE($,'C 2.1','Walls',#800,$,$);
#802=IFCRELASSOCIATESCLASSIFICATION('0CLS00000000000000802',$,$,$,(#310,#330),#801);
ENDSEC;
END-ISO-10303-21;
