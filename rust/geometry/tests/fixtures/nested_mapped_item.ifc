ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('nested_mapped_item.ifc','2026-08-04T00:00:00',(''),(''),'ifc-lite','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCCARTESIANPOINT((0.,0.,0.));
#2=IFCAXIS2PLACEMENT3D(#1,$,$);
#3=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#4=IFCUNITASSIGNMENT((#3));
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0E-5,#2,$);
/* Inner map: a 1000 mm cube at the map origin. */
#6=IFCCARTESIANPOINT((0.,0.));
#7=IFCAXIS2PLACEMENT2D(#6,$);
#8=IFCRECTANGLEPROFILEDEF(.AREA.,'INNER',#7,1000.,1000.);
#9=IFCDIRECTION((0.,0.,1.));
#10=IFCCARTESIANPOINT((500.,500.,0.));
#11=IFCAXIS2PLACEMENT3D(#10,$,$);
#12=IFCEXTRUDEDAREASOLID(#8,#11,#9,1000.);
#13=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#12));
#14=IFCREPRESENTATIONMAP(#2,#13);
/* Outer map: its own 1000 mm cube at the map origin PLUS a nested
   IfcMappedItem pulling in the inner map, scaled 2x and offset 10 m in X. */
#15=IFCRECTANGLEPROFILEDEF(.AREA.,'OUTER',#7,1000.,1000.);
#16=IFCEXTRUDEDAREASOLID(#15,#11,#9,1000.);
#17=IFCCARTESIANPOINT((10000.,0.,0.));
#18=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#17,2.,$);
#19=IFCMAPPEDITEM(#14,#18);
#20=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#16,#19));
#21=IFCREPRESENTATIONMAP(#2,#20);
/* Spatial structure */
#22=IFCLOCALPLACEMENT($,#2);
#23=IFCSITE('0SITE56789ABCDEFGHIJKL',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#24=IFCLOCALPLACEMENT(#22,#2);
#25=IFCBUILDING('0BLDG56789ABCDEFGHIJKL',$,'Building',$,$,#24,$,$,.ELEMENT.,$,$,$);
#26=IFCLOCALPLACEMENT(#24,#2);
#27=IFCBUILDINGSTOREY('0STRY56789ABCDEFGHIJKL',$,'Storey',$,$,#26,$,$,.ELEMENT.,0.);
#28=IFCPROJECT('0PRJ456789ABCDEFGHIJKL',$,'Proj',$,$,$,$,(#5),#4);
/* Occurrence: the outer map, offset 5 m in Y by its MappingTarget. */
#29=IFCCARTESIANPOINT((0.,5000.,0.));
#30=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#29,1.,$);
#31=IFCMAPPEDITEM(#21,#30);
#32=IFCSHAPEREPRESENTATION(#5,'Body','MappedRepresentation',(#31));
#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#32));
#34=IFCLOCALPLACEMENT(#26,#2);
#35=IFCBUILDINGELEMENTPROXY('0PRX056789ABCDEFGHIJKL',$,'NestedMapProxy',$,$,#34,#33,$,$);
#36=IFCRELAGGREGATES('0REL156789ABCDEFGHIJKL',$,$,$,#28,(#23));
#37=IFCRELAGGREGATES('0REL256789ABCDEFGHIJKL',$,$,$,#23,(#25));
#38=IFCRELAGGREGATES('0REL356789ABCDEFGHIJKL',$,$,$,#25,(#27));
#39=IFCRELCONTAINEDINSPATIALSTRUCTURE('0REL456789ABCDEFGHIJKL',$,$,$,(#35),#27);
/* Empty-items source: a well-formed representation with NO geometry items, so
   walking it in `ensure_shared_mapped_source` completes with `mesh` still empty. */
#40=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',());
ENDSEC;
END-ISO-10303-21;
