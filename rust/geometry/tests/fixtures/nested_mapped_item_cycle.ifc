ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('nested_mapped_item_cycle.ifc','2026-08-04T00:00:00',(''),(''),'ifc-lite','ifc-lite','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCCARTESIANPOINT((0.,0.,0.));
#2=IFCAXIS2PLACEMENT3D(#1,$,$);
#3=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#4=IFCUNITASSIGNMENT((#3));
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0E-5,#2,$);
/* A 1000 mm cube, so the recursion has real geometry to walk past. */
#6=IFCCARTESIANPOINT((0.,0.));
#7=IFCAXIS2PLACEMENT2D(#6,$);
#8=IFCRECTANGLEPROFILEDEF(.AREA.,'CUBE',#7,1000.,1000.);
#9=IFCDIRECTION((0.,0.,1.));
#10=IFCCARTESIANPOINT((500.,500.,0.));
#11=IFCAXIS2PLACEMENT3D(#10,$,$);
#12=IFCEXTRUDEDAREASOLID(#8,#11,#9,1000.);
/* Malformed by construction: map A's representation embeds a mapped item on
   map B, whose representation embeds a mapped item back on map A. A naive
   recursion never terminates. */
#13=IFCCARTESIANPOINT((100.,0.,0.));
#14=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#13,1.,$);
#15=IFCMAPPEDITEM(#20,#14);
#16=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#12,#15));
#17=IFCREPRESENTATIONMAP(#2,#16);
#18=IFCMAPPEDITEM(#17,#14);
#19=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#18));
#20=IFCREPRESENTATIONMAP(#2,#19);
/* Spatial structure */
#22=IFCLOCALPLACEMENT($,#2);
#23=IFCSITE('0SITE56789ABCDEFGHIJKL',$,'Site',$,$,#22,$,$,.ELEMENT.,$,$,$,$,$);
#24=IFCLOCALPLACEMENT(#22,#2);
#25=IFCBUILDING('0BLDG56789ABCDEFGHIJKL',$,'Building',$,$,#24,$,$,.ELEMENT.,$,$,$);
#26=IFCLOCALPLACEMENT(#24,#2);
#27=IFCBUILDINGSTOREY('0STRY56789ABCDEFGHIJKL',$,'Storey',$,$,#26,$,$,.ELEMENT.,0.);
#28=IFCPROJECT('0PRJ456789ABCDEFGHIJKL',$,'Proj',$,$,$,$,(#5),#4);
/* Occurrence on map A — entering the cycle. */
#31=IFCMAPPEDITEM(#17,$);
#32=IFCSHAPEREPRESENTATION(#5,'Body','MappedRepresentation',(#31));
#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#32));
#34=IFCLOCALPLACEMENT(#26,#2);
#35=IFCBUILDINGELEMENTPROXY('0PRX056789ABCDEFGHIJKL',$,'CyclicMapProxy',$,$,#34,#33,$,$);
#36=IFCRELAGGREGATES('0REL156789ABCDEFGHIJKL',$,$,$,#28,(#23));
#37=IFCRELAGGREGATES('0REL256789ABCDEFGHIJKL',$,$,$,#23,(#25));
#38=IFCRELAGGREGATES('0REL356789ABCDEFGHIJKL',$,$,$,#25,(#27));
#39=IFCRELCONTAINEDINSPATIALSTRUCTURE('0REL456789ABCDEFGHIJKL',$,$,$,(#35),#27);
ENDSEC;
END-ISO-10303-21;
