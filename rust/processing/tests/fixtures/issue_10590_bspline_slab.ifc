ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('issue_10590_bspline_slab.ifc','',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Synthetic slab for #10590, written by hand. Footprint 4 m x 2 m.
   Bottom: a flat B-spline face (z = 0) on a 2 x 2 control net 6 m x 4 m,
   larger than the face, as Revit/ODA writes it, with SameSense = .F.
   Top: a curved (bilinear, twisted) B-spline face over exactly the footprint,
   corners at z = 0.3 except (4,2) at z = 0.6, with Su x Sv pointing down and
   SameSense = .F., so its outward normal is up. Sides: IfcPlane faces.
   Volume: 4 x 2 x mean height 0.375 = 3.0 m3. */
#1=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'issue 10590',$,$,$,$,(#10),#2);
#2=IFCUNITASSIGNMENT((#3));
#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#11,$);
#11=IFCAXIS2PLACEMENT3D(#12,$,$);
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#20=IFCBUILDING('1kTvXnbbzCWw8lcMd1dR4o',$,'Building',$,$,#21,$,$,.ELEMENT.,$,$,$);
#21=IFCLOCALPLACEMENT($,#11);
#22=IFCBUILDINGSTOREY('2eMpSnnXv5ZhTNmPmoXdTz',$,'Level 0',$,$,#23,$,$,.ELEMENT.,0.);
#23=IFCLOCALPLACEMENT(#21,#11);
#24=IFCRELAGGREGATES('3o3Eq0D0fFNP4qeW5lZ4nQ',$,$,$,#1,(#20));
#25=IFCRELAGGREGATES('0uFIyM8mT7dRHZ2hAZ3JKk',$,$,$,#20,(#22));
#26=IFCRELCONTAINEDINSPATIALSTRUCTURE('2QeEo_hDbAh8x6Kz7k1pWx',$,$,$,(#30),#22);
#30=IFCSLAB('3vB2YO$MX4xv5uCqZZG05x',$,'B-spline slab',$,$,#31,#32,$,.FLOOR.);
#31=IFCLOCALPLACEMENT(#23,#11);
#32=IFCPRODUCTDEFINITIONSHAPE($,$,(#33));
#33=IFCSHAPEREPRESENTATION(#13,'Body','AdvancedBrep',(#34));
#34=IFCADVANCEDBREP(#35);
#35=IFCCLOSEDSHELL((#300,#310,#320,#330,#340,#350));
/* Vertices */
#101=IFCCARTESIANPOINT((0.,0.,0.));
#102=IFCCARTESIANPOINT((4.,0.,0.));
#103=IFCCARTESIANPOINT((4.,2.,0.));
#104=IFCCARTESIANPOINT((0.,2.,0.));
#105=IFCCARTESIANPOINT((0.,0.,0.3));
#106=IFCCARTESIANPOINT((4.,0.,0.3));
#107=IFCCARTESIANPOINT((4.,2.,0.6));
#108=IFCCARTESIANPOINT((0.,2.,0.3));
#111=IFCVERTEXPOINT(#101);
#112=IFCVERTEXPOINT(#102);
#113=IFCVERTEXPOINT(#103);
#114=IFCVERTEXPOINT(#104);
#115=IFCVERTEXPOINT(#105);
#116=IFCVERTEXPOINT(#106);
#117=IFCVERTEXPOINT(#107);
#118=IFCVERTEXPOINT(#108);
/* Edges: bottom E1-E4, top E5-E8, verticals E9-E12 */
#201=IFCEDGECURVE(#111,#112,#221,.T.);
#202=IFCEDGECURVE(#112,#113,#222,.T.);
#203=IFCEDGECURVE(#113,#114,#223,.T.);
#204=IFCEDGECURVE(#114,#111,#224,.T.);
#205=IFCEDGECURVE(#115,#116,#225,.T.);
#206=IFCEDGECURVE(#116,#117,#226,.T.);
#207=IFCEDGECURVE(#117,#118,#227,.T.);
#208=IFCEDGECURVE(#118,#115,#228,.T.);
#209=IFCEDGECURVE(#111,#115,#229,.T.);
#210=IFCEDGECURVE(#112,#116,#230,.T.);
#211=IFCEDGECURVE(#113,#117,#231,.T.);
#212=IFCEDGECURVE(#114,#118,#232,.T.);
#221=IFCPOLYLINE((#101,#102));
#222=IFCPOLYLINE((#102,#103));
#223=IFCPOLYLINE((#103,#104));
#224=IFCPOLYLINE((#104,#101));
#225=IFCPOLYLINE((#105,#106));
#226=IFCPOLYLINE((#106,#107));
#227=IFCPOLYLINE((#107,#108));
#228=IFCPOLYLINE((#108,#105));
#229=IFCPOLYLINE((#101,#105));
#230=IFCPOLYLINE((#102,#106));
#231=IFCPOLYLINE((#103,#107));
#232=IFCPOLYLINE((#104,#108));
/* Bottom: flat B-spline, net 6 m x 4 m around the 4 m x 2 m face, SameSense .F. */
#300=IFCADVANCEDFACE((#301),#305,.F.);
#301=IFCFACEOUTERBOUND(#302,.T.);
#302=IFCEDGELOOP((#303,#304,#306,#307));
#303=IFCORIENTEDEDGE(*,*,#204,.F.);
#304=IFCORIENTEDEDGE(*,*,#203,.F.);
#306=IFCORIENTEDEDGE(*,*,#202,.F.);
#307=IFCORIENTEDEDGE(*,*,#201,.F.);
#305=IFCBSPLINESURFACEWITHKNOTS(1,1,((#361,#362),(#363,#364)),.UNSPECIFIED.,.F.,.F.,.F.,(2,2),(2,2),(0.,1.),(0.,1.),.UNSPECIFIED.);
#361=IFCCARTESIANPOINT((-1.,-1.,0.));
#362=IFCCARTESIANPOINT((-1.,3.,0.));
#363=IFCCARTESIANPOINT((5.,-1.,0.));
#364=IFCCARTESIANPOINT((5.,3.,0.));
/* Top: curved B-spline, U along y and V along x so Su x Sv points down, SameSense .F. */
#310=IFCADVANCEDFACE((#311),#315,.F.);
#311=IFCFACEOUTERBOUND(#312,.T.);
#312=IFCEDGELOOP((#313,#314,#316,#317));
#313=IFCORIENTEDEDGE(*,*,#205,.T.);
#314=IFCORIENTEDEDGE(*,*,#206,.T.);
#316=IFCORIENTEDEDGE(*,*,#207,.T.);
#317=IFCORIENTEDEDGE(*,*,#208,.T.);
#315=IFCBSPLINESURFACEWITHKNOTS(1,1,((#105,#106),(#108,#107)),.UNSPECIFIED.,.F.,.F.,.F.,(2,2),(2,2),(0.,1.),(0.,1.),.UNSPECIFIED.);
/* Front, y = 0 */
#320=IFCADVANCEDFACE((#321),#325,.T.);
#321=IFCFACEOUTERBOUND(#322,.T.);
#322=IFCEDGELOOP((#323,#324,#326,#327));
#323=IFCORIENTEDEDGE(*,*,#201,.T.);
#324=IFCORIENTEDEDGE(*,*,#210,.T.);
#326=IFCORIENTEDEDGE(*,*,#205,.F.);
#327=IFCORIENTEDEDGE(*,*,#209,.F.);
#325=IFCPLANE(#328);
#328=IFCAXIS2PLACEMENT3D(#101,#371,#372);
/* Right, x = 4 */
#330=IFCADVANCEDFACE((#331),#335,.T.);
#331=IFCFACEOUTERBOUND(#332,.T.);
#332=IFCEDGELOOP((#333,#334,#336,#337));
#333=IFCORIENTEDEDGE(*,*,#202,.T.);
#334=IFCORIENTEDEDGE(*,*,#211,.T.);
#336=IFCORIENTEDEDGE(*,*,#206,.F.);
#337=IFCORIENTEDEDGE(*,*,#210,.F.);
#335=IFCPLANE(#338);
#338=IFCAXIS2PLACEMENT3D(#102,#373,#374);
/* Back, y = 2 */
#340=IFCADVANCEDFACE((#341),#345,.T.);
#341=IFCFACEOUTERBOUND(#342,.T.);
#342=IFCEDGELOOP((#343,#344,#346,#347));
#343=IFCORIENTEDEDGE(*,*,#203,.T.);
#344=IFCORIENTEDEDGE(*,*,#212,.T.);
#346=IFCORIENTEDEDGE(*,*,#207,.F.);
#347=IFCORIENTEDEDGE(*,*,#211,.F.);
#345=IFCPLANE(#348);
#348=IFCAXIS2PLACEMENT3D(#104,#375,#372);
/* Left, x = 0 */
#350=IFCADVANCEDFACE((#351),#355,.T.);
#351=IFCFACEOUTERBOUND(#352,.T.);
#352=IFCEDGELOOP((#353,#354,#356,#357));
#353=IFCORIENTEDEDGE(*,*,#204,.T.);
#354=IFCORIENTEDEDGE(*,*,#209,.T.);
#356=IFCORIENTEDEDGE(*,*,#208,.F.);
#357=IFCORIENTEDEDGE(*,*,#212,.F.);
#355=IFCPLANE(#358);
#358=IFCAXIS2PLACEMENT3D(#101,#376,#374);
#371=IFCDIRECTION((0.,-1.,0.));
#372=IFCDIRECTION((1.,0.,0.));
#373=IFCDIRECTION((1.,0.,0.));
#374=IFCDIRECTION((0.,1.,0.));
#375=IFCDIRECTION((0.,1.,0.));
#376=IFCDIRECTION((-1.,0.,0.));
ENDSEC;
END-ISO-10303-21;
