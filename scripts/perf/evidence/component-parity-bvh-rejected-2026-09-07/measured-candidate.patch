+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+use super::{point_inside, point_inside_bvh, BComponents, Tri};
+use crate::kernel::{arrangement::box_mesh, budget};
+
+fn compare(comps: &[&[Tri]], points: impl IntoIterator<Item = [f64; 3]>) {
+    let components = BComponents::new(comps);
+    let mut scratch = Vec::new();
+    for p in points {
+        let before = (budget::count(), budget::element_count());
+        let expected = comps.iter().enumerate().any(|(k, comp)| {
+            components.ray_may_hit(k, p)
+                && point_inside(p, comp, components.exts[k], components.aabbs[k])
+        });
+        assert_eq!(components.inside(p, &mut scratch), expected, "#4054 p={p:?}");
+        assert_eq!((budget::count(), budget::element_count()), before,
+            "#4054 explicit parity must not alter escalation budgets");
+    }
+}
+
+#[test]
+fn issue_4054_component_bvh_matches_brute_at_boundaries_and_large_coordinates() {
+    for (origin, scale) in [(0.0, 1.0), (-1e8, 3.0), (1e8, 0.01), (0.0, 1e-6)] {
+        let a = box_mesh([origin; 3], [origin + scale; 3]);
+        let b = box_mesh([origin + 3.0 * scale; 3], [origin + 4.0 * scale; 3]);
+        let coords = [-2.0, -1e-9, 0.0, 1e-9, 0.5, 1.0 - 1e-9, 1.0, 1.0 + 1e-9, 3.5, 6.0];
+        let points = coords.into_iter().flat_map(|x| coords.into_iter().flat_map(move |y| {
+            coords.into_iter().map(move |z| [origin + x * scale, origin + y * scale, origin + z * scale])
+        }));
+        compare(&[&a, &b], points);
+        compare(&[&b, &a], [[origin + 0.5 * scale; 3], [origin + 3.5 * scale; 3]]);
+    }
+    compare(&[&[]], [[0.0; 3], [1e8; 3]]);
+}
+
+#[test]
+fn issue_4054_dense_component_prunes_candidates_and_preserves_exact_parity() {
+    let mut mesh = Vec::new();
+    for x in 0..16 {
+        for y in 0..8 {
+            let (x, y) = (x as f64 * 3.0, y as f64 * 3.0);
+            mesh.extend(box_mesh([x, y, 0.0], [x + 1.0, y + 1.0, 1.0]));
+        }
+    }
+    let refs = [&mesh[..]];
+    let components = BComponents::new(&refs);
+    let p = [0.5, 0.5, 0.5];
+    let mut scratch = Vec::new();
+    let got = point_inside_bvh(p, &mesh, &components.bvhs[0], components.exts[0],
+        Some(components.aabbs[0]), &mut scratch);
+    assert_eq!(got, point_inside(p, &mesh, components.exts[0], components.aabbs[0]));
+    assert!(got, "analytic interior of the first closed box");
+    assert!(scratch.len() < mesh.len() / 8, "#4054 pruning must be exercised");
+    compare(&[&mesh], (0..2048).map(|i| {
+        let t = i as f64;
+        [(t * 0.618_033_988_75).fract() * 52.0 - 2.0,
+         (t * 0.414_213_562_37).fract() * 28.0 - 2.0,
+         (t * 0.732_050_807_57).fract() * 5.0 - 2.0]
+    }));
+}
