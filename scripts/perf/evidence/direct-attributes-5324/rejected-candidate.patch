index 000000000..1ac1d365b
--- /dev/null
+++ b/rust/core/src/parser/tokenizer_sink.rs
@@ -0,0 +1,42 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! Construction targets for the single STEP grammar (#5324).
+use super::Token;
+use crate::AttributeValue;
+
+pub(super) trait ValueSink<'a> {
+    type Value;
+    fn finish(values: Vec<Self::Value>) -> Vec<Self::Value> { values }
+    fn scalar(value: Token<'a>) -> Self::Value;
+    fn list(values: Vec<Self::Value>) -> Self::Value;
+    fn typed(name: &'a [u8], values: Vec<Self::Value>) -> Self::Value;
+}
+
+pub(super) struct TokenSink;
+impl<'a> ValueSink<'a> for TokenSink {
+    type Value = Token<'a>;
+    fn scalar(value: Token<'a>) -> Self::Value { value }
+    fn list(values: Vec<Self::Value>) -> Self::Value { Token::List(values) }
+    fn typed(name: &'a [u8], values: Vec<Self::Value>) -> Self::Value {
+        Token::TypedValue(name, values)
+    }
+}
+
+pub(super) struct AttributeSink;
+impl<'a> ValueSink<'a> for AttributeSink {
+    type Value = AttributeValue;
+    fn finish(mut values: Vec<Self::Value>) -> Vec<Self::Value> {
+        // The old Token -> AttributeValue collect allocated the final lists to
+        // their exact size. nom grows geometrically; do not retain that spare
+        // capacity in every returned entity merely because construction is direct.
+        values.shrink_to_fit();
+        values
+    }
+    fn scalar(value: Token<'a>) -> Self::Value { AttributeValue::from_token(&value) }
+    fn list(values: Vec<Self::Value>) -> Self::Value { AttributeValue::List(Self::finish(values)) }
+    fn typed(name: &'a [u8], values: Vec<Self::Value>) -> Self::Value {
+        AttributeValue::from_typed_parts(name, values)
+    }
+}
