@@ -0,0 +1,88 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+use super::*;
+use crate::AttributeValue;
+
+fn same_value(left: &AttributeValue, right: &AttributeValue) {
+    use AttributeValue::*;
+    match (left, right) {
+        (Float(a), Float(b)) => assert_eq!(a.to_bits(), b.to_bits()),
+        (Integer(a), Integer(b)) => assert_eq!(a, b),
+        (EntityRef(a), EntityRef(b)) => assert_eq!(a, b),
+        (String(a), String(b)) | (Enum(a), Enum(b)) => assert_eq!(a, b),
+        (List(a), List(b)) => {
+            assert_eq!(a.len(), b.len());
+            for (a, b) in a.iter().zip(b) { same_value(a, b); }
+        }
+        (Null, Null) | (Derived, Derived) => {}
+        _ => panic!("attribute variants differ"),
+    }
+}
+
+// #5324: direct construction must equal the public token conversion, including
+// exact floating-point bits and the grammar's accepted/rejected input boundary.
+fn compare(bytes: &[u8]) {
+    match (parse_entity(bytes), parse_entity_attributes(bytes)) {
+        (Ok((id, ty, tokens)), Ok((direct_id, direct_ty, attrs))) => {
+            assert_eq!((id, ty), (direct_id, direct_ty));
+            assert_eq!(tokens.len(), attrs.len());
+            for (token, attr) in tokens.iter().zip(&attrs) {
+                same_value(&AttributeValue::from_token(token), attr);
+            }
+        }
+        (Err(a), Err(b)) => assert_eq!(a.to_string(), b.to_string()),
+        _ => panic!("token and direct grammar disagree"),
+    }
+}
+
+#[test]
+fn issue_5324_direct_construction_preserves_scalars_lists_and_typed_values() {
+    for bytes in [
+        b"#1=IFCX($,*,#4294967295,+42,-42,-0.,1.25E-3,.true.);".as_slice(),
+        br"#2=IFCX('O''Brien','\X2\00E4\X0\',ifclabel('x'),IFCREAL(2.));",
+        b"#3=IFCX(( ),(/*empty*/),ifclabel(\r\n),((#1),(#2,$)));",
+        b"#4=IFCX('invalid \xff',\"double quoted\",.ENUM_2.);",
+        b"#5=IFCX(1.52.3);",
+        b"#6=IFCX(#4294967296);",
+        b"#7=IFCX('readable',(@));",
+        b"#8=IFCX('unterminated);",
+        b"#9=IFCX(1.E999999);",
+        b"#10=IFCX('valid');ignored trailing bytes",
+    ] { compare(bytes); }
+    // Independent expected values protect string escape/typed-name semantics.
+    let (_, _, attrs) = parse_entity_attributes(br"#1=IFCX('O''Brien',ifclabel('\X2\00E4\X0\'));" ).unwrap();
+    assert_eq!(attrs[0].as_string(), Some("O'Brien"));
+    let AttributeValue::List(typed) = &attrs[1] else { panic!("typed wrapper missing") };
+    assert_eq!(typed[0].as_string(), Some("IFCLABEL"));
+    assert_eq!(typed[1].as_string(), Some("ä"));
+}
+
+#[test]
+fn issue_5324_direct_construction_preserves_depth_limit() {
+    for depth in [0, 1, 16, 255, 256, 257, 300] {
+        let source = format!("#1=IFCX({}1{});", "(".repeat(depth), ")".repeat(depth));
+        compare(source.as_bytes());
+    }
+}
+
+#[test]
+fn issue_5324_real_model_attributes_match_public_token_conversion() {
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../tests/models");
+    for relative in ["ara3d/AC20-FZK-Haus.ifc", "issues/472_2222.ifc", "ara3d/schependomlaan.ifc"] {
+        let path = root.join(relative);
+        if !path.exists() {
+            eprintln!("Skipping {relative}: run pnpm fixtures");
+            continue;
+        }
+        let source = std::fs::read(path).unwrap();
+        let mut scanner = crate::parser::EntityScanner::new(&source);
+        let mut compared = 0;
+        while let Some((_, _, start, end)) = scanner.next_entity() {
+            compare(&source[start..end]);
+            compared += 1;
+        }
+        assert!(compared > 0, "real fixture must exercise decoded records");
+    }
+}
