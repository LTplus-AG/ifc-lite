diff --git a/rust/export/src/gltf/spool_spike.rs b/rust/export/src/gltf/spool_spike.rs
new file mode 100644
index 000000000..2ba478d02
--- /dev/null
+++ b/rust/export/src/gltf/spool_spike.rs
@@ -0,0 +1,60 @@
+//! #5357 experiment only: private native scratch, not a production persistence format.
+//! I/O errors deliberately fail the experiment. This needs typed error propagation
+//! and platform policy before shipping. No full mesh collection is retained.
+use ifc_lite_processing::MeshData;
+use std::fs::{File, OpenOptions};
+use std::io::{BufReader, BufWriter, Read, Seek, SeekFrom, Write};
+
+pub(super) struct Spool {
+    writer: BufWriter<File>,
+    count: usize,
+}
+
+impl Spool {
+    pub(super) fn from_env() -> Option<Self> {
+        let path = std::env::var_os("IFC_SPIKE_SPOOL")?;
+        let file = OpenOptions::new().read(true).write(true).create_new(true)
+            .open(&path).expect("create exclusive spike spool");
+        // Linux experiment: unlink immediately, so abort/error cannot leak scratch.
+        std::fs::remove_file(path).expect("unlink private spike spool");
+        Some(Self { writer: BufWriter::with_capacity(1024 * 1024, file), count: 0 })
+    }
+    pub(super) fn record(&mut self, m: &MeshData) {
+        let w = &mut self.writer;
+        w.write_all(&m.express_id.to_le_bytes()).unwrap();
+        w.write_all(bytemuck::cast_slice(&m.color)).unwrap();
+        w.write_all(bytemuck::cast_slice(&m.origin)).unwrap();
+        for bytes in [m.ifc_type.as_bytes(), bytemuck::cast_slice(&m.positions),
+            bytemuck::cast_slice(&m.normals), bytemuck::cast_slice(&m.indices)] {
+            w.write_all(&(bytes.len() as u64).to_le_bytes()).unwrap();
+            w.write_all(bytes).unwrap();
+        }
+        self.count += 1;
+    }
+    pub(super) fn replay(&mut self, mut emit: impl FnMut(MeshData)) {
+        self.writer.flush().unwrap();
+        let bytes = self.writer.stream_position().unwrap();
+        self.writer.seek(SeekFrom::Start(0)).unwrap();
+        let mut r = BufReader::with_capacity(1024 * 1024, self.writer.get_mut());
+        fn read<const N: usize>(r: &mut impl Read) -> [u8; N] {
+            let mut b = [0; N]; r.read_exact(&mut b).unwrap(); b
+        }
+        fn vec<T: bytemuck::Pod + Default>(r: &mut impl Read) -> Vec<T> {
+            let n = u64::from_le_bytes(read(r)) as usize;
+            assert_eq!(n % std::mem::size_of::<T>(), 0);
+            let mut v = vec![T::default(); n / std::mem::size_of::<T>()];
+            r.read_exact(bytemuck::cast_slice_mut(&mut v)).unwrap(); v
+        }
+        for _ in 0..self.count {
+            let id = u32::from_le_bytes(read(&mut r));
+            let color = std::array::from_fn(|_| f32::from_le_bytes(read(&mut r)));
+            let origin = std::array::from_fn(|_| f64::from_le_bytes(read(&mut r)));
+            let kind = String::from_utf8(vec::<u8>(&mut r)).unwrap();
+            let mut m = MeshData::new(id, kind, vec(&mut r), vec(&mut r), vec(&mut r), color);
+            m.origin = origin;
+            emit(m);
+        }
+        assert_eq!(r.stream_position().unwrap(), bytes);
+        eprintln!("spool_bytes={bytes}");
+    }
+}
