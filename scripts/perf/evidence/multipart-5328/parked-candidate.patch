diff --git a/rust/geometry/src/router/mapped_parts.rs b/rust/geometry/src/router/mapped_parts.rs
new file mode 100644
index 000000000..e361e2e21
--- /dev/null
+++ b/rust/geometry/src/router/mapped_parts.rs
@@ -0,0 +1,80 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+//! Opt-in multi-part source ownership (#5328). Separate from map-id cache keys.
+use super::{GeometryRouter, MappedInstancePlan};
+use crate::{Mesh, InstanceMeta};
+use ifc_lite_core::{DecodedEntity, EntityDecoder, IfcType};
+use rustc_hash::{FxHashMap, FxHashSet};
+use std::sync::{Arc, Mutex};
+
+/// Source-part meshes for one immutable content/quality/scale pass. The opaque
+/// identity keys cannot collide with ids in `SharedMappedItemCache`.
+pub type SharedMappedPartCache = Arc<Mutex<FxHashMap<u128, Arc<Mesh>>>>;
+
+pub(super) fn part_identity(source: u32, item: u32) -> u128 {
+    // Direct-solid hashes have bit 127 set; single-map ids occupy only 32 bits.
+    (1u128 << 64) | ((source as u128) << 32) | item as u128
+}
+
+impl GeometryRouter {
+    /// One per model/worker session, cleared with content, scale or quality.
+    pub fn new_mapped_part_cache() -> SharedMappedPartCache {
+        Arc::new(Mutex::new(FxHashMap::default()))
+    }
+
+    /// Opt in only when the consumer resolves templates by BOTH express id and
+    /// rep_identity. The existing single-part entry point retains its contract.
+    pub fn enable_output_instancing_parts(&mut self, plan: MappedInstancePlan, cache: SharedMappedPartCache) {
+        self.enable_output_instancing(plan);
+        self.shared_mapped_part_cache = Some(cache);
+    }
+
+    pub(super) fn mapped_source_parts(
+        &self, source: u32, repr: &DecodedEntity, decoder: &mut EntityDecoder,
+        textures: Option<&FxHashMap<u32, crate::processors::texture::ResolvedTextureMap>>,
+    ) -> Option<FxHashSet<u32>> {
+        self.shared_mapped_part_cache.as_ref()?;
+        self.output_instancing_plan()?.get(&source).filter(|&&(count, _)| count >= 2)?;
+        let items = decoder.resolve_ref_list(repr.get(3)?).ok()?;
+        if items.len() < 2 { return None; }
+        let mut ids = FxHashSet::default();
+        for item in items {
+            if item.ifc_type == IfcType::IfcMappedItem
+                || self.is_indexed_colour_split_source(item.id)
+                || textures.is_some_and(|t| t.contains_key(&item.id))
+                || !ids.insert(item.id) {
+                return None;
+            }
+        }
+        Some(ids)
+    }
+
+    /// Return a pose-only mesh only AFTER a complete, non-budget-degraded source
+    /// is present. A failed/degraded build is returned/propagated once, never
+    /// re-run under an already spent element budget or cached for other products.
+    pub(super) fn mapped_part_occurrence(
+        &self, source: u32, item: &DecodedEntity, decoder: &mut EntityDecoder,
+    ) -> crate::Result<Mesh> {
+        let Some(cache) = &self.shared_mapped_part_cache else {
+            return self.process_representation_item(item, decoder);
+        };
+        let rep = part_identity(source, item.id);
+        let present = cache.lock().unwrap_or_else(|e| e.into_inner()).contains_key(&rep);
+        if !present {
+            let mut mesh = self.process_representation_item(item, decoder)?;
+            if mesh.is_empty() || crate::kernel::budget::tripped() { return Ok(mesh); }
+            mesh.instance_meta = None;
+            let mesh = Arc::new(mesh);
+            cache.lock().unwrap_or_else(|e| e.into_inner()).entry(rep).or_insert(mesh);
+        }
+        let mut mesh = Mesh::new();
+        mesh.instance_meta = Some(InstanceMeta {
+            transform: super::processing::IDENTITY_ROW_MAJOR,
+            local_transform: None, canonical_transform: None,
+            rep_identity: rep, instanceable: true,
+        });
+        Ok(mesh)
+    }
+}
