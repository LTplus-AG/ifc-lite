+/// #5328: the opt-in path keeps both source solids without baking every occurrence.
+/// Compare expanded world vertices, topology, colours and metadata to the canonical
+/// flat pipeline; checking only instance counts would miss lost/misplaced parts.
+#[test]
+fn multipart_dont_bake_reconstructs_every_part() {
+    let bytes = fixture_bytes("mapped_instances_multi_item.ifc");
+    let flat = run(&bytes);
+    let parts = ifc_lite_processing::process_geometry_streaming_with_mapped_parts(
+        &bytes, OpeningFilterMode::Default,
+        StreamingOptions { enable_instancing: true, ..StreamingOptions::default() },
+        |_, _, _| {}, |_| {}, |_| {},
+    );
+    assert_eq!(flat.meshes.len(), 8);
+    assert_eq!(parts.meshes.len(), 2, "only one template per source part");
+    assert_eq!(parts.instances.len(), 6);
+    for reference in &flat.meshes {
+        let key = (reference.express_id, reference.geometry_item_id);
+        let retained = parts.meshes.iter().find(|m| (m.express_id, m.geometry_item_id) == key);
+        let (vertices, indices, color, global_id, name) = if let Some(m) = retained {
+            (world_vertices(m), &m.indices, m.color, &m.global_id, &m.name)
+        } else {
+            let rec = parts.instances.iter().find(|rec| (rec.express_id, rec.geometry_item_id) == key)
+                .expect("every flat part has an occurrence");
+            let template = parts.meshes.iter().find(|m| m.express_id == rec.template_express_id
+                && m.instance.as_ref().is_some_and(|im| im.rep_identity == rec.rep_identity))
+                .expect("exact part template");
+            (world_vertices(template).into_iter().map(|p| apply(&rec.transform, p)).collect(),
+             &template.indices, rec.color, &rec.global_id, &rec.name)
+        };
+        assert_eq!(indices, &reference.indices);
+        assert_eq!(color, reference.color);
+        assert_eq!(global_id, &reference.global_id);
+        assert_eq!(name, &reference.name);
+        assert!(max_vertex_error(&vertices, &world_vertices(reference)) < 1e-4);
+    }
+    // Existing callers keep the single-solid contract even when instancing is enabled.
+    let old = process_geometry_streaming_filtered_with_options(
+        &bytes, OpeningFilterMode::Default,
+        StreamingOptions { enable_instancing: true, ..StreamingOptions::default() },
+        |_, _, _| {}, |_| {}, |_| {},
+    );
+    assert!(old.instances.is_empty());
+    assert_eq!(old.meshes.len(), 8);
+}
