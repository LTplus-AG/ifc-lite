+
+//! The current mesh's unique vertices in ascending Vid order.
+use super::interner::Vid;
+use super::retriangulate::SubTri;
+
+/// Preserve the former BTreeSet iteration sequence, including before callers
+/// choose their prefilter threshold. Equal integer IDs have no payload whose
+/// insertion order must survive, so an unstable sort is sufficient (#4055).
+pub(super) fn ordered_vertices(tris: &[SubTri]) -> Vec<Vid> {
+    let mut vertices: Vec<Vid> = tris.iter().flatten().copied().collect();
+    vertices.sort_unstable();
+    vertices.dedup();
+    vertices
+}
