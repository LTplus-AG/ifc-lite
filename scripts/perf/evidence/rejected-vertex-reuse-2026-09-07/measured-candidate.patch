+
+#[test]
+fn vertex_inventory_reuse_matches_fresh_inventory_after_recovery_and_bails() {
+    use super::retriangulate_enforce::enforce_constraint;
+    use super::retriangulate_vertices::ordered_vertices;
+    let mut it = Interner::new();
+    let (mut cached, a, b) = pinch_mesh(&mut it);
+    let mut fresh = Mesh2d {
+        tris: cached.tris.clone(), axis: cached.axis, w0: cached.w0,
+        unrecovered: 0, audit_needed: false, coords: BTreeMap::new(),
+    };
+    let mut constraints = vec![(a, b), (b, a)];
+    constraints.extend(cached.tris.iter().map(|tri| (tri[0], tri[1])));
+    let mut inventory = None;
+    let mut mutations = 0;
+    let mut unchanged = 0;
+    for _ in 0..3 {
+        for &(s, t) in &constraints {
+            let before = cached.tris.clone();
+            let current = inventory.get_or_insert_with(|| ordered_vertices(&cached.tris));
+            assert_eq!(*current, ordered_vertices(&cached.tris));
+            let changed = enforce_constraint(&mut cached, &it, s, t, current);
+            if changed {
+                mutations += 1;
+                inventory = None;
+            } else {
+                unchanged += 1;
+                assert_eq!(cached.tris, before, "false must certify no triangle mutation");
+            }
+            let current = ordered_vertices(&fresh.tris);
+            enforce_constraint(&mut fresh, &it, s, t, &current);
+            assert_eq!(cached.tris, fresh.tris);
+            assert_eq!(cached.audit_needed, fresh.audit_needed);
+            assert_eq!(cached.unrecovered, fresh.unrecovered);
+        }
+    }
+    assert!(mutations > 0 && unchanged > 0, "exercise invalidation and reuse");
+}
