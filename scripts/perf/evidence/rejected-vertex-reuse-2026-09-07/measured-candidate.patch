@@ -0,0 +1,31 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+use super::*;
+use std::collections::BTreeSet;
+
+#[test]
+fn issue_4055_vertex_sequence_matches_ordered_set_before_prefilter_selection() {
+    // Duplicated triangle corners must not inflate the threshold decision;
+    // permutation must not alter the subsequent exact-predicate call order.
+    for count in [0, 1, 2, 15, 16, 17, 31, 32, 33, 127, 512] {
+        let mut tris = Vec::new();
+        for i in 0..count {
+            let a = (i * 37 % count) as Vid;
+            let b = (i * 19 % count) as Vid;
+            tris.extend([[a, b, a], [b, b, a]]);
+        }
+        let expected: Vec<Vid> = tris.iter().flatten().copied()
+            .collect::<BTreeSet<_>>().into_iter().collect();
+        assert_eq!(ordered_vertices(&tris), expected);
+        tris.reverse();
+        assert_eq!(ordered_vertices(&tris), expected);
+    }
+}
+
+#[test]
+fn issue_4055_vertex_order_keeps_full_width_ids_and_degenerate_faces() {
+    let tris = [[Vid::MAX, 0, Vid::MAX], [1, 1, 0], [Vid::MAX - 1, 1, 0]];
+    assert_eq!(ordered_vertices(&tris), [0, 1, Vid::MAX - 1, Vid::MAX]);
+}
