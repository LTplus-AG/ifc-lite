{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifclite.dev/schemas/ai-eval/manifest-v1.json",
  "title": "IFClite AI evaluation manifest (version 1)",
  "description": "Versioned, privacy-reviewed corpus for viewer AI evaluation (#6928). Enforced by scripts/ai-eval/check-ai-eval-manifest.mjs; see docs/architecture/viewer-ai-evaluation.md.",
  "type": "object",
  "required": ["version", "updated", "privacy", "journeys", "scenes", "fixtures", "liveEvaluation", "tasks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "privacy": {
      "type": "object",
      "required": ["policy", "automatedScan", "humanReview"],
      "additionalProperties": false,
      "properties": {
        "policy": { "type": "string", "minLength": 20 },
        "automatedScan": { "type": "string", "minLength": 10 },
        "humanReview": { "$ref": "#/$defs/review" }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 3 } }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "fixtures", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "enum": ["clash", "validation", "compare", "flow", "loadReport"] },
          "fixtures": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "origin", "kind", "path", "sha256", "size", "source", "license", "privacy"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "origin": { "enum": ["committed", "fixtures"], "description": "committed: in git; fixtures: catalogued in tests/models/manifest.json and fetched by pnpm fixtures." },
          "kind": { "enum": ["ifc", "ids", "native-result"] },
          "path": { "type": "string", "pattern": "^(apps|tests)/[\\w./-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "schema": { "enum": ["IFC2X3", "IFC4", "IFC4X3"] },
          "source": {
            "type": "object",
            "required": ["authoringTool", "description"],
            "additionalProperties": false,
            "properties": {
              "authoringTool": { "type": "string", "minLength": 2 },
              "description": { "type": "string", "minLength": 10 },
              "derivedFrom": { "$ref": "#/$defs/id" },
              "derivation": { "type": "string" }
            }
          },
          "license": {
            "type": "object",
            "required": ["status", "note"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["recorded", "unrecorded"] },
              "spdx": { "type": "string" },
              "note": { "type": "string", "minLength": 10 }
            }
          },
          "privacy": {
            "type": "object",
            "required": ["automated", "human"],
            "additionalProperties": false,
            "properties": {
              "automated": { "enum": ["pass", "not-fetched"], "description": "Recomputed by the gate; a committed fixture must pass." },
              "human": { "$ref": "#/$defs/review" }
            }
          }
        }
      }
    },
    "liveEvaluation": {
      "type": "object",
      "required": ["maxOutputTokens", "timeoutMs", "maxRepeats", "budget", "providers"],
      "additionalProperties": false,
      "properties": {
        "maxOutputTokens": { "type": "integer", "minimum": 256, "maximum": 32768 },
        "timeoutMs": { "type": "integer", "minimum": 10000, "maximum": 600000 },
        "maxRepeats": { "type": "integer", "minimum": 1, "maximum": 10 },
        "budget": {
          "type": "object",
          "required": ["maxRequests", "maxOutputTokens"],
          "additionalProperties": false,
          "properties": {
            "maxRequests": { "type": "integer", "minimum": 1, "maximum": 500 },
            "maxOutputTokens": { "type": "integer", "minimum": 256 }
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "credential"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["proxy", "anthropic", "openai"] },
              "credential": { "type": "string", "description": "Where the runner reads the credential: an environment variable name, or none for the hosted free proxy." }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "journey", "scene", "prompt", "inputScope", "expectedOutput", "invariants", "labels", "reviewers"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "journey": { "$ref": "#/$defs/id" },
          "scene": { "$ref": "#/$defs/id" },
          "prompt": { "type": "string", "minLength": 5, "maxLength": 8000 },
          "inputScope": { "type": "string", "minLength": 10 },
          "expectedOutput": { "enum": ["prose", "clash.groups", "flow.patch", "model.changes", "model.authoring"] },
          "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "enum": ["claims", "grouping", "classification"] } },
          "reviewers": { "$ref": "#/$defs/review" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$" },
    "review": {
      "type": "object",
      "required": ["status", "reviewers"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "complete"] },
        "reviewers": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" }, "description": "Pseudonymous reviewer ids only; never names or emails." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    }
  }
}
