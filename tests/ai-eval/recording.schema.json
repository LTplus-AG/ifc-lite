{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifclite.dev/schemas/ai-eval/recording-v1.json",
  "title": "IFClite AI evaluation recording (version 1)",
  "description": "One provider response as SSE data payloads, replayed through the viewer Assistant path (apps/viewer/src/test/ai-eval-replay.ts) and checked by scripts/ai-eval/check-ai-eval-invariants.mjs. Recordings test IFClite behaviour on a fixed answer, not model quality.",
  "type": "object",
  "required": ["version", "id", "task", "scene", "corpus", "prompt", "route", "provenance", "response", "evidence"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "task": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "scene": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "corpus": { "enum": ["release", "negative", "live"], "description": "release: zero invariant violations required; negative: proves a detector fires (expect.violations non-empty); live: produced by run-live-eval.mjs, not yet reviewed." },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "route": {
      "type": "object",
      "required": ["kind", "model"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["proxy", "anthropic", "openai"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "recordedAt", "note"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["authored", "live"], "description": "authored: written by a person to exercise a behaviour; live: the verbatim stream of a real provider request." },
        "recordedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "note": { "type": "string", "minLength": 1 },
        "receipt": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "events": { "type": "array", "items": { "type": "object" } },
        "done": { "type": "boolean" },
        "body": { "type": "string" }
      }
    },
    "evidence": { "type": "object", "required": ["source", "totalRows", "includedRows", "evidence"], "description": "The captured evidence payload the answer was given, minus capturedAt (comparableEvidence)." },
    "expect": {
      "type": "object",
      "required": ["outcome", "proposal", "violations"],
      "additionalProperties": false,
      "properties": {
        "outcome": { "enum": ["completed", "truncated", "error"] },
        "error": { "type": "string" },
        "proposal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "valid"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["clash.groups", "flow.patch", "model.changes", "model.authoring"] },
                "valid": { "type": "boolean" },
                "reason": { "type": "string" }
              }
            }
          ]
        },
        "review": { "type": "object", "description": "Expected native review fields (ai-eval-review.ts NativeReview), compared as a subset." },
        "usage": {
          "type": "object",
          "required": ["reported"],
          "additionalProperties": false,
          "properties": {
            "reported": { "type": "boolean", "description": "false: the stream carried no usage and the receipt must say so; nothing is estimated." },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
