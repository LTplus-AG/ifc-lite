{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifclite.dev/schemas/ai-eval/study-protocol-v1.json",
  "title": "IFClite U01 coordinator study protocol (version 1)",
  "type": "object",
  "required": ["version", "status", "note", "thresholds", "minimumParticipantsPerRole", "roles", "variants", "design", "measures", "tasks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "status": { "enum": ["proposed", "ratified"] },
    "note": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "required": ["unaidedCompletionRate", "assistedCompletionNotBelowCurrent", "maxWrongTargetEffects"],
      "additionalProperties": false,
      "properties": {
        "unaidedCompletionRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "assistedCompletionNotBelowCurrent": { "type": "boolean" },
        "maxWrongTargetEffects": { "type": "integer", "minimum": 0 }
      }
    },
    "minimumParticipantsPerRole": { "type": "integer", "minimum": 1 },
    "roles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "description"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "description": { "type": "string" } } } },
    "variants": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "description"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "description": { "type": "string" } } } },
    "design": { "type": "string", "minLength": 1 },
    "measures": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "description"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "description": { "type": "string" } } } },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "journey", "scene", "roles", "capSeconds", "participantPrompt", "startState", "success", "entry"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,40}$" },
          "title": { "type": "string" },
          "journey": { "type": "string" },
          "scene": { "type": "string" },
          "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "capSeconds": { "type": "integer", "minimum": 30 },
          "participantPrompt": { "type": "string", "minLength": 1 },
          "startState": { "type": "string" },
          "success": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "entry": {
            "type": "object",
            "required": ["current", "assisted"],
            "additionalProperties": false,
            "properties": {
              "current": { "$ref": "#/$defs/route" },
              "assisted": { "$ref": "#/$defs/route" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["group", "panels"],
      "additionalProperties": false,
      "properties": {
        "group": { "enum": ["coordinate", "check", "quantify", "automate", "site", "author"] },
        "panels": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Workspace panel ids (apps/viewer/src/lib/panels/registry.ts) the participant is expected to use." }
      }
    }
  }
}
