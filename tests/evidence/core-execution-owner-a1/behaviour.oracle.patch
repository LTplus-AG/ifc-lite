diff --git b/rust/core/src/execution_owner.rs a/rust/core/src/execution_owner.rs
index 106e22795a..333a4ee439 100644
--- b/rust/core/src/execution_owner.rs
+++ a/rust/core/src/execution_owner.rs
@@ -87,6 +87,10 @@ impl ExecutionOwner {
     }
     /// Invalidate pending work without releasing its owner's reservation.
     pub fn changed(&mut self) {
+        self.generation = self
+            .generation
+            .checked_add(1)
+            .expect("execution generation space exhausted");
         if let Some(state) = self.state.get() {
             state.generation.store(self.generation, Ordering::Release);
         }
