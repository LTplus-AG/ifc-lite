+        if !(query_mag <= *reach) {
+            return point_inside(p, comp, self.exts[k], self.aabbs[k]);
+        }
+        let mut candidates = Vec::new();
+        bvh.ray_candidates(p, far, &mut candidates);
+        candidates.iter().filter(|&&i| exact_seg_hits_tri(p, far, &comp[i as usize])).count() % 2 == 1
     }
 }
