-            *next_bid,
-            length_unit_scale,
-            Some(noise_area),
-        );
-        *next_bid += 1;
+        let plan = plan_one(&own, use_tag, bid, length_unit_scale, Some(noise_area));
         plans.push(plan);
     }
 }
