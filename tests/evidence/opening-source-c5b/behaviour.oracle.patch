     pub(crate) fn run(mut self, router: &GeometryRouter, decoder: &mut EntityDecoder) -> Result<Vec<Mesh>> {
         let fault = |error| protocol(&format!("opening child {error:?}"));
         loop {
+            crate::resource::check_current()?;
