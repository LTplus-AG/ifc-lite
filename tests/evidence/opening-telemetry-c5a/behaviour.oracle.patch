diff --git a/rust/geometry/src/telemetry_transaction.rs b/rust/geometry/src/telemetry_transaction.rs
index 4be21a34b3..15a5b8ecdc 100644
--- a/rust/geometry/src/telemetry_transaction.rs
+++ b/rust/geometry/src/telemetry_transaction.rs
@@ -72,7 +72,16 @@ thread_local! {
 
 /// Buffer into the innermost open attempt, or publish immediately when none.
 pub(crate) fn record(event: Event) {
-    event.publish();
+    let buffered = PENDING.with(|pending| match pending.borrow_mut().last_mut() {
+        Some(buffer) => {
+            buffer.push(event);
+            true
+        }
+        None => false,
+    });
+    if !buffered {
+        event.publish();
+    }
 }
 
 /// Must stay on the thread that owns its buffer, including during unwinding.
