--- a/apps/viewer/src/index.css
+++ b/apps/viewer/src/index.css
@@ -262,10 +262,22 @@
   --color-card-foreground: hsl(240 10% 3.9%);
   --color-popover: hsl(0 0% 100%);
   --color-popover-foreground: hsl(240 10% 3.9%);
-  --color-primary: var(--tokyo-blue);
-  /* Tokyo blue is a light accent: dark ink clears AA where white measured
-     only 2.52:1 (#4792). */
-  --color-primary-foreground: var(--tokyo-night);
+  /* Light theme primary (#8802 R4): a deep Tokyo blue with white ink. The
+     old light primary was Tokyo blue itself, a light accent at 2.52:1 on
+     the white panel, so filled primary buttons read as disabled. Dark keeps
+     Tokyo blue with dark ink, where it is the strong end of the scale. */
+  --color-primary: #2e5fcf;
+  --color-primary-foreground: #ffffff;
+  /* #8802 R4 state language, one treatment for every "this is on" state:
+     a pressed toggle, the selected segment, the focused command row, an
+     active filter or isolation. Primary-tinted surface, `active` ink for
+     text and icons, and the same ink for indicator bars and edges. The
+     solid primary fill stays reserved for the panel's one next action.
+     Ink on the surface clears 4.5:1 over panel, raised and input wells. */
+  --color-active: #2350b0;
+  --color-active-surface: color-mix(in srgb, var(--color-primary) 14%, transparent);
+  --color-active-surface-hover: color-mix(in srgb, var(--color-primary) 20%, transparent);
+  --color-active-border: color-mix(in srgb, var(--color-active) 60%, transparent);
   --color-secondary: hsl(240 4.8% 95.9%);
   --color-secondary-foreground: hsl(240 5.9% 10%);
   --color-muted: hsl(240 4.8% 95.9%);
