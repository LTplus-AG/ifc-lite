+thread_local! { pub(super) static R20_HOST: std::cell::Cell<u64> = const { std::cell::Cell::new(0) }; }
+pub(super) fn r20_fp(m: &Mesh) -> u64 {
+    let mut h: u64 = 0xcbf29ce484222325;
+    for p in &m.positions { h = (h ^ p.to_bits() as u64).wrapping_mul(0x100000001b3); }
+    for i in &m.indices { h = (h ^ *i as u64).wrapping_mul(0x100000001b3); }
+    for o in &m.origin { h = (h ^ o.to_bits()).wrapping_mul(0x100000001b3); }
+    h
+}
+pub(super) fn r20_log(site: &str, result: &Mesh, cand_dir: &Vector3<f64>, used: &Vector3<f64>, tris: usize) {
+    let host = R20_HOST.with(|c| c.get()) == r20_fp(result);
+    let dir = cand_dir.x.to_bits() == used.x.to_bits() && cand_dir.y.to_bits() == used.y.to_bits() && cand_dir.z.to_bits() == used.z.to_bits();
+    eprintln!("R20 {site} host_same={host} dir_same={dir} cutter_tris={tris} host_tris={}", result.indices.len() / 3);
+}
