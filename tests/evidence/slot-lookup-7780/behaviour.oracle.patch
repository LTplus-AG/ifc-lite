diff --git b/rust/core/src/attribute_slot.rs a/rust/core/src/attribute_slot.rs
--- b/rust/core/src/attribute_slot.rs
+++ a/rust/core/src/attribute_slot.rs
@@ -93,8 +93,8 @@ fn decode(index: usize, flags: u8) -> AttrSlot {
         // every schema in the tests); Select is the conservative reading of
