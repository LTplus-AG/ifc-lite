// ifc-lite spike: bounds algebra that today exists twice — in the Rust kernel
// (mesh bounds folding, host-AABB clip pads) and in the TS viewer
// (frame-selection bounds, MeshData.origin folding).
// Written once here; compiled to Rust and TypeScript by Plato.CLI.

type BBox3
{
    Min: Vector3D;
    Max: Vector3D;
}

library Bounds
{
    EmptyBox(): BBox3
        => new BBox3(
            new Vector3D(1e300, 1e300, 1e300),
            new Vector3D(-1e300, -1e300, -1e300));

    IsEmptyBox(b: BBox3): Boolean
        => b.Max.X < b.Min.X || b.Max.Y < b.Min.Y || b.Max.Z < b.Min.Z;

    Include(b: BBox3, p: Vector3D): BBox3
        => new BBox3(b.Min.Min(p), b.Max.Max(p));

    Union(a: BBox3, b: BBox3): BBox3
        => new BBox3(a.Min.Min(b.Min), a.Max.Max(b.Max));

    Center(b: BBox3): Vector3D
        => b.Min.MidPoint(b.Max);

    Extent(b: BBox3): Vector3D
        => b.Max.Subtract(b.Min);

    HalfDiagonal(b: BBox3): Number
        => b.Extent.Length * 0.5;

    Contains(b: BBox3, p: Vector3D): Boolean
        => p.X >= b.Min.X && p.X <= b.Max.X
        && p.Y >= b.Min.Y && p.Y <= b.Max.Y
        && p.Z >= b.Min.Z && p.Z <= b.Max.Z;

    Intersects(a: BBox3, b: BBox3): Boolean
        => a.Min.X <= b.Max.X && a.Max.X >= b.Min.X
        && a.Min.Y <= b.Max.Y && a.Max.Y >= b.Min.Y
        && a.Min.Z <= b.Max.Z && a.Max.Z >= b.Min.Z;

    // MeshData.origin fold: world bounds = local bounds + per-element origin.
    FoldOrigin(b: BBox3, origin: Vector3D): BBox3
        => new BBox3(b.Min.Add(origin), b.Max.Add(origin));

    // Symmetric pad, e.g. the host-AABB clip pad applied to void cutters.
    Expand(b: BBox3, pad: Number): BBox3
        => new BBox3(
            b.Min.Subtract(new Vector3D(pad, pad, pad)),
            b.Max.Add(new Vector3D(pad, pad, pad)));
}
