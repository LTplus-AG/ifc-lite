{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel-build.sh '@ifc-lite/viewer...'",
  "outputDirectory": "apps/viewer/dist",
  "installCommand": "bash scripts/vercel-install.sh",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/reports/capabilities",
      "destination": "https://model-reports-production.up.railway.app/api/reports/capabilities"
    },
    {
      "source": "/api/reports/session",
      "destination": "https://model-reports-production.up.railway.app/api/reports/session"
    },
    {
      "source": "/api/reports/resolve-issue",
      "destination": "https://model-reports-production.up.railway.app/api/reports/resolve-issue"
    },
    {
      "source": "/api/reports/public/:token([a-f0-9]{64})",
      "destination": "https://model-reports-production.up.railway.app/api/reports/public/:token"
    },
    {
      "source": "/api/reports/drafts",
      "destination": "https://model-reports-production.up.railway.app/api/reports/drafts"
    },
    {
      "source": "/api/reports/:reportId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})",
      "destination": "https://model-reports-production.up.railway.app/api/reports/:reportId"
    },
    {
      "source": "/api/reports/:reportId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})/:action(consent|agreement\\.pdf|custom-nda|uploads|submit|public-model)",
      "destination": "https://model-reports-production.up.railway.app/api/reports/:reportId/:action"
    },
    {
      "source": "/api/reports/:reportId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})/uploads/:uploadId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})",
      "destination": "https://model-reports-production.up.railway.app/api/reports/:reportId/uploads/:uploadId"
    },
    {
      "source": "/api/reports/:reportId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})/uploads/:uploadId([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})/:action(parts|complete|abort)",
      "destination": "https://model-reports-production.up.railway.app/api/reports/:reportId/uploads/:uploadId/:action"
    },
    {
      "source": "/api/autodesk/:path*",
      "destination": "https://autodesk-production-50bc.up.railway.app/api/autodesk/:path*"
    },
    {
      "source": "/api/cloud/:path*",
      "destination": "https://cloud-production-6b9b.up.railway.app/api/cloud/:path*"
    },
    {
      "source": "/oauth/autodesk/callback",
      "destination": "/oauth/autodesk/callback.html"
    },
    {
      "source": "/api/epsg/:path*",
      "destination": "https://epsg.io/:path*"
    },
    {
      "source": "/api/bsdd/:path*",
      "destination": "https://api.bsdd.buildingsmart.org/:path*"
    },
    {
      "source": "/api/dalux/:path*",
      "destination": "/api/dalux?path=:path*"
    },
    {
      "source": "/oauth/dropbox/callback",
      "destination": "/oauth/dropbox/callback.html"
    },
    {
      "source": "/oauth/msgraph/callback",
      "destination": "/oauth/msgraph/callback.html"
    },
    {
      "source": "/oauth/bcf/callback",
      "destination": "/oauth/bcf/callback.html"
    },
    {
      "source": "/mcp",
      "destination": "/index.html"
    },
    {
      "source": "/mcp/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/oauth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
